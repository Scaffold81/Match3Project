  m_Script: {fileID: 11500000, guid: 2b17b268e1fb7734bb975e5058e1bd11, type: 3}
  m_Name: Stage01_Story
  m_EditorClassIdentifier: Assembly-CSharp::Match3.Configs.StageStoryConfig
  <StageSelectStory>k__BackingField:
    <Image>k__BackingField: {fileID: 0}
    <LocalizationId>k__BackingField: china_01_select
    <FallbackText>k__BackingField: "\u0423\u0447\u0435\u043D\u0438\u043A. \u0422\u044B
      \u043F\u0440\u0438\u0448\u0451\u043B. \u041D\u0435\u0444\u0440\u0438\u0442\u043E\u0432\u044B\u0439
      \u0414\u0440\u0430\u043A\u043E\u043D \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u043B\u0441\u044F
      \u2014 \u043F\u0440\u0438\u0447\u0438\u043D\u0430 \u043D\u0435\u0432\u0430\u0436\u043D\u0430,
      \u0432\u0430\u0436\u043D\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435.
      \u041F\u0435\u0440\u0432\u044B\u0439 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442
      \u0432 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u0441\u043A\u043E\u043C
      \u0441\u0430\u0434\u0443. \u0421\u043E\u0431\u0435\u0440\u0438 \u043F\u044F\u0442\u044C
      \u0446\u0432\u0435\u0442\u043E\u0432 \u043A\u0430\u043C\u043D\u0435\u0439 \u2014
      \u043E\u043D\u0438 \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0430\u044E\u0442
      \u043F\u044F\u0442\u044C \u0434\u043E\u0431\u0440\u043E\u0434\u0435\u0442\u0435\u043B\u0435\u0439.
      \u0418\u0434\u0438."
  <LevelStories>k__BackingField:
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_01_l1_start
      <FallbackText>k__BackingField: "\u041C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u0441\u043A\u0438\u0439
        \u0441\u0430\u0434 \u2014 \u043C\u0435\u0441\u0442\u043E \u043F\u043E\u043A\u043E\u044F.
        \u041D\u043E \u043F\u043E\u043A\u043E\u0439 \u043D\u0435 \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442
        \u0431\u0435\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435. \u041F\u044F\u0442\u044C
        \u0446\u0432\u0435\u0442\u043E\u0432 \u043A\u0430\u043C\u043D\u0435\u0439
        \u2014 \u043F\u044F\u0442\u044C \u0434\u043E\u0431\u0440\u043E\u0434\u0435\u0442\u0435\u043B\u0435\u0439:
        \u043C\u0443\u0434\u0440\u043E\u0441\u0442\u044C, \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E\u0441\u0442\u044C,
        \u0440\u0438\u0442\u0443\u0430\u043B, \u0433\u0443\u043C\u0430\u043D\u043D\u043E\u0441\u0442\u044C,
        \u0447\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C. \u0421\u043E\u0431\u0435\u0440\u0438
        \u0432\u0441\u0435 \u043F\u044F\u0442\u044C \u2014 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442
        \u0434\u0440\u0430\u043A\u043E\u043D\u0430 \u043E\u0442\u043A\u043B\u0438\u043A\u043D\u0435\u0442\u0441\u044F."
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_01_l1_lose
      <FallbackText>k__BackingField: "\u041A\u0430\u043C\u043D\u0438 \u043D\u0435
        \u043E\u0442\u043E\u0437\u0432\u0430\u043B\u0438\u0441\u044C. \u041C\u043E\u0436\u0435\u0442
        \u0431\u044B\u0442\u044C \u0442\u044B \u0442\u043E\u0440\u043E\u043F\u0438\u043B\u0441\u044F.
        \u041F\u043E\u0441\u043F\u0435\u0448\u043D\u043E\u0441\u0442\u044C \u2014
        \u0432\u0440\u0430\u0433 \u043C\u0443\u0434\u0440\u043E\u0441\u0442\u0438.
        \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u0441\u043D\u043E\u0432\u0430
        \u2014 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435 \u0434\u0443\u043C\u0430\u0439,
        \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u0435\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0439."
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_01_l2_start
      <FallbackText>k__BackingField: "\u0421\u0430\u0434 \u043F\u043E\u043C\u043D\u0438\u0442
        \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u043A\u0442\u043E \u043F\u043E
        \u043D\u0435\u043C\u0443 \u0445\u043E\u0434\u0438\u043B. \u041C\u043E\u043D\u0430\u0445\u0438,
        \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0438, \u0432\u0435\u0442\u0435\u0440.
        \u041A\u0430\u043C\u043D\u0438 \u0437\u0434\u0435\u0441\u044C \u043F\u0440\u043E\u043F\u0438\u0442\u0430\u043D\u044B
        \u0438\u0441\u0442\u043E\u0440\u0438\u0435\u0439. \u0421\u043E\u0431\u0435\u0440\u0438
        \u0438\u0445 \u2014 \u0438 \u0443\u0441\u043B\u044B\u0448\u0438\u0448\u044C
        \u044D\u0442\u0443 \u0438\u0441\u0442\u043E\u0440\u0438\u044E."
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_01_l2_lose
      <FallbackText>k__BackingField: "\u0418\u0441\u0442\u043E\u0440\u0438\u044F
        \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u043B\u0430\u0441\u044C. \u0423\u0447\u0435\u043D\u0438\u043A,
        \u0438\u043D\u043E\u0433\u0434\u0430 \u043D\u0443\u0436\u043D\u043E \u043F\u0440\u043E\u0441\u0442\u043E
        \u0431\u044B\u0442\u044C \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u0435\u0435
        \u2014 \u0438 \u0441\u043D\u043E\u0432\u0430."
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_01_l3_start
      <FallbackText>k__BackingField: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
        \u043A\u0430\u043C\u043D\u0438 \u0443 \u0441\u0442\u0430\u0440\u043E\u0433\u043E
        \u0433\u0438\u043D\u043A\u0433\u043E. \u042D\u0442\u043E \u0434\u0435\u0440\u0435\u0432\u043E
        \u0432\u0438\u0434\u0435\u043B\u043E dynasty \u0437\u0430 dynasty. \u041F\u043E\u043A\u0430
        \u0442\u044B \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0448\u044C \u043A\u0430\u043C\u043D\u0438
        \u2014 \u043F\u043E\u0441\u043B\u0443\u0448\u0430\u0439 \u0435\u0433\u043E
        \u0448\u0435\u043B\u0435\u0441\u0442. \u0422\u0430\u043C \u043E\u0442\u0432\u0435\u0442\u044B
        \u043D\u0430 \u0432\u043E\u043F\u0440\u043E\u0441\u044B \u043A\u043E\u0442\u043E\u0440\u044B\u0435
        \u0442\u044B \u0435\u0449\u0451 \u043D\u0435 \u0437\u0430\u0434\u0430\u043B."
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_01_l3_win
      <FallbackText>k__BackingField: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442
        \u043D\u0430\u0439\u0434\u0435\u043D. \u0414\u0440\u0430\u043A\u043E\u043D
        \u0447\u0443\u0442\u044C \u0442\u0435\u043F\u043B\u0435\u0435... \u044F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E
        \u0447\u0435\u0440\u0435\u0437 \u043B\u0430\u0434\u043E\u043D\u0438. \u0425\u043E\u0440\u043E\u0448\u0438\u0439
        \u0437\u043D\u0430\u043A \u0443\u0447\u0435\u043D\u0438\u043A. \u0418\u0434\u0451\u043C
        \u0432 \u0433\u043E\u0440\u044B \u2014 \u0442\u0430\u043C \u0432\u0442\u043E\u0440\u043E\u0439
        \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442. \u0418 \u0442\u0430\u043C
        \u0441\u043B\u043E\u0436\u043D\u0435\u0435."
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_01_l3_lose
      <FallbackText>k__BackingField: "\u0413\u0438\u043D\u043A\u0433\u043E \u0442\u0435\u0440\u043F\u0435\u043B\u0438\u0432.
        \u0423\u0447\u0435\u043D\u0438\u043A\u0438 \u0442\u043E\u0436\u0435 \u0434\u043E\u043B\u0436\u043D\u044B
        \u0431\u044B\u0442\u044C. \u0415\u0449\u0451 \u0440\u0430\u0437 \u2014 \u0438
        \u0431\u0435\u0437 \u0441\u043F\u0435\u0448\u043A\u0438."
