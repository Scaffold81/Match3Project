  m_Script: {fileID: 11500000, guid: 2b17b268e1fb7734bb975e5058e1bd11, type: 3}
  m_Name: Stage07_Story
  m_EditorClassIdentifier: Assembly-CSharp::Match3.Configs.StageStoryConfig
  <StageSelectStory>k__BackingField:
    <Image>k__BackingField: {fileID: 0}
    <LocalizationId>k__BackingField: china_07_select
    <FallbackText>k__BackingField: "\u0425\u0440\u0430\u043C \u041D\u0435\u0431\u0430
      \u2014 \u043C\u0435\u0441\u0442\u043E \u0433\u0434\u0435 \u0438\u043C\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u044B
      \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438 \u0441 \u0431\u043E\u0433\u0430\u043C\u0438.
      \u0427\u0435\u0442\u044B\u0440\u0435 \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u044B\u0445
      \u0446\u0435\u043F\u0438 \u0437\u0430\u043F\u0438\u0440\u0430\u044E\u0442 \u0430\u043B\u0442\u0430\u0440\u044C.
      \u041F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A \u043F\u0440\u0438\u0448\u0451\u043B
      \u0441\u044E\u0434\u0430 \u043F\u0435\u0440\u0432\u044B\u043C \u0438 \u0443\u043A\u0440\u0435\u043F\u0438\u043B
      \u0437\u0430\u043C\u043A\u0438. \u041D\u043E \u043D\u0435\u0431\u043E \u0441\u043B\u044B\u0448\u0438\u0442
      \u043D\u0430\u0441 \u2014 \u0438 \u043F\u043E\u043C\u043E\u0436\u0435\u0442."
  <LevelStories>k__BackingField:
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_07_l1_start
      <FallbackText>k__BackingField: "\u0426\u0435\u043F\u0438 \u0443 \u0425\u0440\u0430\u043C\u0430
        \u041D\u0435\u0431\u0430 \u043F\u043B\u0435\u0442\u0435\u043D\u044B \u0438\u0437
        \u043B\u0443\u043D\u043D\u043E\u0433\u043E \u0441\u0435\u0440\u0435\u0431\u0440\u0430
        \u2014 \u043A\u0440\u0435\u043F\u043A\u0438\u0435 \u043D\u043E \u043D\u0435
        \u043D\u0435\u0441\u043E\u043A\u0440\u0443\u0448\u0438\u043C\u044B\u0435.
        \u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0435 \u043C\u0430\u0442\u0447\u0438
        \u0440\u044F\u0434\u043E\u043C \u0441 \u043D\u0438\u043C\u0438 \u043E\u0441\u043B\u0430\u0431\u044F\u0442
        \u043F\u043B\u0435\u0442\u0435\u043D\u0438\u0435. \u041D\u0430\u0447\u0438\u043D\u0430\u0435\u043C
        \u0441 \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u0439 \u0446\u0435\u043F\u0438
        \u2014 \u043E\u043D\u0430 \u0447\u0443\u0442\u044C \u0442\u043E\u043D\u044C\u0448\u0435
        \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445."
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_07_l1_lose
      <FallbackText>k__BackingField: "\u0421\u0435\u0440\u0435\u0431\u0440\u043E
        \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F. \u041B\u0443\u043D\u0430
        \u0435\u0449\u0451 \u043D\u0435 \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442
        \u2014 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0443\u0433\u043E\u043B
        \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439.
        \u041F\u0440\u043E\u0431\u0443\u0435\u043C \u0441\u043D\u043E\u0432\u0430
        \u043F\u043E\u0434 \u0434\u0440\u0443\u0433\u0438\u043C \u043D\u0435\u0431\u043E\u043C!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_07_l2_start
      <FallbackText>k__BackingField: "\u041D\u0435\u0431\u043E \u0441\u0432\u0435\u0442\u043B\u0435\u0435\u0442!
        \u0411\u043E\u0433\u0438 \u0441\u043B\u044B\u0448\u0430\u0442 \u043D\u0430\u0441
        \u2014 \u044F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E. \u0414\u0432\u0435
        \u0446\u0435\u043F\u0438 \u0435\u0449\u0451 \u0441\u0442\u043E\u044F\u0442.
        \u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439, \u0443\u0447\u0435\u043D\u0438\u043A
        \u2014 \u043D\u0435\u0431\u043E \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442
        \u043F\u0440\u0430\u0432\u043E\u0435 \u0434\u0435\u043B\u043E."
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_07_l2_lose
      <FallbackText>k__BackingField: "\u041F\u0440\u0430\u0432\u043E\u0435 \u0434\u0435\u043B\u043E
        \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0445
        \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439. \u041D\u0435\u0431\u043E
        \u0436\u0434\u0451\u0442 \u2014 \u0438 \u043C\u044B \u0436\u0434\u0451\u043C
        \u043D\u0435 \u0437\u0440\u044F!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_07_l3_start
      <FallbackText>k__BackingField: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
        \u0446\u0435\u043F\u0438 \u0443 \u0430\u043B\u0442\u0430\u0440\u044F! \u041F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A
        \u0441\u0442\u043E\u0438\u0442 \u0437\u0430 \u0441\u0442\u0435\u043D\u043E\u0439
        \u2014 \u044F \u0441\u043B\u044B\u0448\u0443 \u0448\u0430\u0433\u0438. \u041E\u043D
        \u0442\u043E\u0440\u043E\u043F\u0438\u0442\u0441\u044F. \u0417\u043D\u0430\u0447\u0438\u0442
        \u043D\u0430\u043C \u043D\u0443\u0436\u043D\u043E \u0443\u0441\u043F\u0435\u0442\u044C
        \u0440\u0430\u043D\u044C\u0448\u0435. \u0420\u0430\u0437\u0440\u044B\u0432\u0430\u0435\u043C
        \u2014 \u0438 \u0430\u043B\u0442\u0430\u0440\u044C \u043E\u0442\u043A\u0440\u044B\u0442!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_07_l3_win
      <FallbackText>k__BackingField: "\u0410\u043B\u0442\u0430\u0440\u044C \u043E\u0442\u043A\u0440\u044B\u0442!
        \u0418 \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u0432\u0438\u0436\u0443
        \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430 \u043B\u0438\u0446\u043E\u043C
        \u043A \u043B\u0438\u0446\u0443 \u2014 \u044D\u0442\u043E \u041B\u0443\u043D
        \u0412\u0430\u043D, \u0434\u0443\u0445-\u0443\u0437\u0443\u0440\u043F\u0430\u0442\u043E\u0440.
        \u041E\u043D \u0445\u043E\u0442\u0435\u043B \u0437\u0430\u043D\u044F\u0442\u044C
        \u043C\u0435\u0441\u0442\u043E \u0414\u0440\u0430\u043A\u043E\u043D\u0430.
        \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442
        \u043D\u0443\u0436\u043D\u043E \u0441\u043E\u0431\u0440\u0430\u0442\u044C
        \u043D\u0430 \u0413\u043E\u0440\u0435 \u041A\u0443\u043D\u044C-\u041B\u0443\u043D\u044C."
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_07_l3_lose
      <FallbackText>k__BackingField: "\u041B\u0443\u043D \u0412\u0430\u043D \u0442\u043E\u0440\u043E\u043F\u0438\u0442
        \u2014 \u0437\u043D\u0430\u0447\u0438\u0442 \u043E\u043D \u0431\u043E\u0438\u0442\u0441\u044F.
        \u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u0434\u0435\u043B\u0430\u0435\u0442!
        \u0415\u0449\u0451 \u0440\u0430\u0437 \u2014 \u0438 \u043C\u044B \u0443\u0441\u043F\u0435\u0435\u043C!"
