  <StageSelectStory>k__BackingField:
    <Image>k__BackingField: {fileID: 0}
    <LocalizationId>k__BackingField: china_09_select
    <FallbackText>k__BackingField: "\u041D\u0435\u0444\u0440\u0438\u0442\u043E\u0432\u044B\u0439
      \u0414\u0432\u043E\u0440\u0435\u0446 \u2014 \u043E\u0431\u0438\u0442\u0435\u043B\u044C
      \u0414\u0440\u0430\u043A\u043E\u043D\u0430. \u041B\u0443\u043D \u0412\u0430\u043D
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
      \u0441\u0438\u043B\u044B \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u0442\u044C
      \u0435\u0433\u043E \u043B\u044C\u0434\u043E\u043C \u0438 \u0446\u0435\u043F\u044F\u043C\u0438.
      \u041E\u043D \u0445\u043E\u0447\u0435\u0442 \u0437\u0430\u043F\u0435\u0440\u0435\u0442\u044C
      \u0414\u0440\u0430\u043A\u043E\u043D\u0430 \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430.
      \u041C\u044B \u0441 \u0448\u0435\u0441\u0442\u044C\u044E \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u0430\u043C\u0438
      \u0434\u043E\u043B\u0436\u043D\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044C
      \u0434\u0432\u043E\u0440\u0435\u0446 \u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C
      \u0432\u043E\u0437\u0440\u043E\u0436\u0434\u0435\u043D\u0438\u0435."
  <LevelStories>k__BackingField:
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_09_l1_start
      <FallbackText>k__BackingField: "\u041B\u0451\u0434 \u041B\u0443\u043D \u0412\u0430\u043D\u0430
        \u0443 \u0432\u0445\u043E\u0434\u0430 \u2014 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
        \u043E\u0442\u0447\u0430\u044F\u043D\u043D\u044B\u0439 \u0431\u0430\u0440\u044C\u0435\u0440.
        \u041E\u0442\u0447\u0430\u044F\u043D\u0438\u0435 \u043F\u0440\u0438\u0434\u0430\u0451\u0442
        \u0435\u043C\u0443 \u0441\u0438\u043B\u0443 \u043D\u043E \u043B\u0438\u0448\u0430\u0435\u0442
        \u0440\u0430\u0437\u0443\u043C\u0430. \u041D\u0430\u043C \u044D\u0442\u043E
        \u043D\u0430 \u0440\u0443\u043A\u0443. \u0420\u0430\u0437\u0431\u0438\u0432\u0430\u0435\u043C
        \u043C\u0435\u0442\u043E\u0434\u0438\u0447\u043D\u043E \u2014 \u0438 \u0432\u0445\u043E\u0434\u0438\u043C."
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_09_l1_lose
      <FallbackText>k__BackingField: "\u041E\u0442\u0447\u0430\u044F\u043D\u0438\u0435
        \u043A\u0440\u0435\u043F\u043A\u043E\u0435. \u041D\u043E \u043D\u0435 \u043A\u0440\u0435\u043F\u0447\u0435
        \u0440\u0435\u0448\u0438\u043C\u043E\u0441\u0442\u0438. \u0421\u043D\u043E\u0432\u0430!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_09_l2_start
      <FallbackText>k__BackingField: "\u0426\u0435\u043F\u0438 \u0443 \u043D\u0435\u0444\u0440\u0438\u0442\u043E\u0432\u044B\u0445
        \u0432\u043E\u0440\u043E\u0442 \u2014 \u0441\u0442\u0430\u0440\u0438\u043D\u043D\u044B\u0435,
        \u043A\u0440\u0435\u043F\u043A\u0438\u0435. \u042D\u0442\u043E \u0443\u0436\u0435
        \u043D\u0435 \u041B\u0443\u043D \u0412\u0430\u043D, \u044D\u0442\u043E \u0434\u0440\u0435\u0432\u043D\u044F\u044F
        \u0437\u0430\u0449\u0438\u0442\u0430 \u0441\u0430\u043C\u043E\u0433\u043E
        \u0414\u0432\u043E\u0440\u0446\u0430. \u041E\u043D\u0430 \u0442\u0435\u0441\u0442\u0438\u0440\u0443\u0435\u0442
        \u043D\u0430\u0441: \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u044B \u043B\u0438
        \u043C\u044B \u0432\u043E\u0439\u0442\u0438. \u041C\u044B \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u044B.
        \u0414\u043E\u043A\u0430\u0436\u0435\u043C!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_09_l2_lose
      <FallbackText>k__BackingField: "\u0414\u0432\u043E\u0440\u0435\u0446 \u0441\u043E\u043C\u043D\u0435\u0432\u0430\u0435\u0442\u0441\u044F
        \u0432 \u043D\u0430\u0441. \u041F\u043E\u043D\u044F\u0442\u043D\u043E. \u041F\u043E\u043A\u0430\u0436\u0435\u043C
        \u0435\u043C\u0443 \u0447\u0442\u043E \u043D\u0430\u043F\u0440\u0430\u0441\u043D\u043E
        \u2014 \u0435\u0449\u0451 \u0440\u0430\u0437!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_09_l3_start
      <FallbackText>k__BackingField: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
        \u0431\u0430\u0440\u044C\u0435\u0440 \u2014 \u043B\u0451\u0434 \u0438 \u0446\u0435\u043F\u0438
        \u0443 \u0441\u0430\u043C\u043E\u0433\u043E \u0441\u0435\u0440\u0434\u0446\u0430
        \u0414\u0432\u043E\u0440\u0446\u0430 \u0433\u0434\u0435 \u043B\u0435\u0436\u0438\u0442
        \u0414\u0440\u0430\u043A\u043E\u043D. \u0421\u043E\u0431\u0435\u0440\u0438
        \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0435 \u043A\u0430\u043C\u043D\u0438
        \u0438 \u0440\u0430\u0437\u0440\u0443\u0448\u044C \u043F\u0440\u0435\u0433\u0440\u0430\u0434\u044B.
        \u0428\u0435\u0441\u0442\u044C \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u043E\u0432
        \u0436\u0434\u0443\u0442 \u043C\u043E\u043C\u0435\u043D\u0442\u0430 \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F.
        \u0421\u0435\u0439\u0447\u0430\u0441 \u0438\u043B\u0438 \u043D\u0438\u043A\u043E\u0433\u0434\u0430,
        \u0443\u0447\u0435\u043D\u0438\u043A!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_09_l3_win
      <FallbackText>k__BackingField: "\u0414\u0412\u041E\u0420\u0415\u0426 \u041E\u0422\u041A\u0420\u042B\u0422!
        \u0428\u0435\u0441\u0442\u044C \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u043E\u0432
        \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u043B\u0438\u0441\u044C! \u041D\u0435\u0444\u0440\u0438\u0442\u043E\u0432\u044B\u0439
        \u0414\u0440\u0430\u043A\u043E\u043D \u0432\u043E\u0437\u0440\u043E\u0436\u0434\u0430\u0435\u0442\u0441\u044F...
        \u0438 \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
        \u0441\u043E\u0432\u0441\u0435\u043C \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u043C.
        \u0420\u0430\u0437\u043C\u0435\u0440\u043E\u043C \u0441 \u043A\u043E\u0442\u0451\u043D\u043A\u0430.
        \u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u043D\u0430\u0441
        \u0438... \u0447\u0438\u0445\u0430\u0435\u0442. \u041C\u0430\u0441\u0442\u0435\u0440
        \u0412\u044D\u0439 \u0441\u043C\u0435\u0451\u0442\u0441\u044F \u0432\u043F\u0435\u0440\u0432\u044B\u0435
        \u0437\u0430 \u0441\u0442\u043E \u043B\u0435\u0442."
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_09_l3_lose
      <FallbackText>k__BackingField: "\u0424\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0439
        \u043C\u043E\u043C\u0435\u043D\u0442 \u2014 \u0434\u0435\u0440\u0436\u0438\u0441\u044C!
        \u0415\u0449\u0451 \u043E\u0434\u0438\u043D \u0440\u0430\u0437 \u0438 \u0414\u0440\u0430\u043A\u043E\u043D
        \u0441\u0432\u043E\u0431\u043E\u0434\u0435\u043D!"
