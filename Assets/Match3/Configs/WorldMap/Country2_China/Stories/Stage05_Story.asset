  m_Script: {fileID: 11500000, guid: 2b17b268e1fb7734bb975e5058e1bd11, type: 3}
  m_Name: Stage05_Story
  m_EditorClassIdentifier: Assembly-CSharp::Match3.Configs.StageStoryConfig
  <StageSelectStory>k__BackingField:
    <Image>k__BackingField: {fileID: 0}
    <LocalizationId>k__BackingField: china_05_select
    <FallbackText>k__BackingField: "\u0412\u0435\u043B\u0438\u043A\u0430\u044F \u0421\u0442\u0435\u043D\u0430
      \u2014 \u0442\u044B\u0441\u044F\u0447\u0438 \u043B\u0438 \u043A\u0430\u043C\u043D\u044F.
      \u0417\u0434\u0435\u0441\u044C \u0445\u0440\u0430\u043D\u0438\u043B\u0441\u044F
      \u043F\u044F\u0442\u044B\u0439 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442
      \u2014 \u0432\u0441\u0442\u0440\u043E\u0435\u043D \u043F\u0440\u044F\u043C\u043E
      \u0432 \u043A\u043B\u0430\u0434\u043A\u0443. \u041A\u0430\u043C\u0435\u043D\u043D\u044B\u0435
      \u0431\u043B\u043E\u043A\u0438 \u043E\u0431\u0440\u0443\u0448\u0438\u043B\u0438\u0441\u044C
      \u0438 \u043D\u0430\u043A\u0440\u044B\u043B\u0438 \u0435\u0433\u043E. \u0420\u0430\u0441\u0447\u0438\u0441\u0442\u0438\u043C
      \u0437\u0430\u0432\u0430\u043B\u044B \u0438 \u043D\u0430\u0439\u0434\u0451\u043C
      \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442."
  <LevelStories>k__BackingField:
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_05_l1_start
      <FallbackText>k__BackingField: "\u041A\u0430\u043C\u0435\u043D\u043D\u044B\u0435
        \u0431\u043B\u043E\u043A\u0438 \u043E\u0442 \u043E\u0431\u0440\u0443\u0448\u0435\u043D\u043D\u044B\u0445
        \u0437\u0443\u0431\u0446\u043E\u0432. \u0422\u044F\u0436\u0451\u043B\u044B\u0435,
        \u043D\u043E \u043D\u0435 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0435
        \u2014 \u0440\u0430\u0437\u0431\u0438\u0432\u0430\u0435\u043C \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u043C\u0438
        \u043C\u0430\u0442\u0447\u0430\u043C\u0438 \u0440\u044F\u0434\u043E\u043C.
        \u0424\u0440\u0430\u0433\u043C\u0435\u043D\u0442 \u0414\u0440\u0430\u043A\u043E\u043D\u0430
        \u0441\u0432\u0435\u0442\u0438\u0442\u0441\u044F \u043F\u043E\u0434 \u0437\u0430\u0432\u0430\u043B\u043E\u043C
        \u2014 \u0441\u0438\u043D\u0435\u0432\u0430\u0442\u044B\u0439 \u043E\u0433\u043E\u043D\u0451\u043A.
        \u041E\u043D \u0436\u0438\u0432. \u0418\u0434\u0451\u043C \u043A \u043D\u0435\u043C\u0443."
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_05_l1_lose
      <FallbackText>k__BackingField: "\u0417\u0430\u0432\u0430\u043B \u043F\u043B\u043E\u0442\u043D\u0435\u0435
        \u0447\u0435\u043C \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C. \u0421\u0442\u0435\u043D\u0443
        \u0441\u0442\u0440\u043E\u0438\u043B\u0438 \u043D\u0430\u0434\u043E\u043B\u0433\u043E.
        \u041D\u043E \u043C\u044B \u0443\u043F\u043E\u0440\u043D\u0435\u0435 \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u0435\u0439
        \u2014 \u0435\u0449\u0451 \u0440\u0430\u0437!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_05_l2_start
      <FallbackText>k__BackingField: "\u041F\u043E\u043B\u043E\u0432\u0438\u043D\u0430
        \u0437\u0430\u0432\u0430\u043B\u0430 \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u043D\u0430!
        \u041E\u0433\u043E\u043D\u0451\u043A \u0414\u0440\u0430\u043A\u043E\u043D\u0430
        \u0441\u0442\u0430\u043B \u044F\u0440\u0447\u0435 \u2014 \u043E\u043D \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442
        \u0447\u0442\u043E \u043C\u044B \u0431\u043B\u0438\u0437\u043A\u043E. \u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439
        \u2014 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0431\u043B\u043E\u043A\u0438
        \u0443 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F \u0441\u0442\u0435\u043D\u044B
        \u0441\u0430\u043C\u044B\u0435 \u0442\u044F\u0436\u0451\u043B\u044B\u0435."
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_05_l2_lose
      <FallbackText>k__BackingField: "\u041E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0435
        \u043A\u0440\u0435\u043F\u043A\u043E. \u041A\u0430\u043A \u0438 \u0434\u043E\u043B\u0436\u043D\u0430
        \u0434\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F \u0412\u0435\u043B\u0438\u043A\u0430\u044F
        \u0421\u0442\u0435\u043D\u0430. \u0415\u0449\u0451 \u0440\u0430\u0437 \u2014
        \u0441 \u0434\u0440\u0443\u0433\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_05_l3_start
      <FallbackText>k__BackingField: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
        \u0431\u043B\u043E\u043A\u0438 \u043F\u0440\u044F\u043C\u043E \u043D\u0430\u0434
        \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u043E\u043C! \u0412\u0438\u0434\u0438\u0448\u044C
        \u0441\u0438\u043D\u0435\u0435 \u0441\u0432\u0435\u0447\u0435\u043D\u0438\u0435?
        \u042D\u0442\u043E \u0414\u0440\u0430\u043A\u043E\u043D \u0437\u043E\u0432\u0451\u0442.
        \u0420\u0430\u0437\u0431\u0435\u0439 \u044D\u0442\u0438 \u0431\u043B\u043E\u043A\u0438
        \u2014 \u0438 \u043F\u044F\u0442\u044B\u0439 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442
        \u0443 \u043D\u0430\u0441."
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_05_l3_win
      <FallbackText>k__BackingField: "\u041F\u044F\u0442\u044B\u0439 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442!
        \u0414\u0440\u0430\u043A\u043E\u043D \u043F\u043E\u0447\u0442\u0438 \u0446\u0435\u043B\u044B\u0439
        \u2014 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043D\u0430\u0439\u0442\u0438
        \u0448\u0435\u0441\u0442\u043E\u0439. \u042F \u0437\u043D\u0430\u044E \u0433\u0434\u0435
        \u043E\u043D. \u0412 \u0441\u0430\u043C\u043E\u043C \u043E\u043F\u0430\u0441\u043D\u043E\u043C
        \u043C\u0435\u0441\u0442\u0435 \u2014 \u0432 \u043B\u043E\u0433\u043E\u0432\u0435
        \u0442\u043E\u0433\u043E \u043A\u0442\u043E \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u043B
        \u0414\u0440\u0430\u043A\u043E\u043D\u0430."
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_05_l3_lose
      <FallbackText>k__BackingField: "\u0414\u0440\u0430\u043A\u043E\u043D \u0437\u043E\u0432\u0451\u0442
        \u2014 \u044F \u0441\u043B\u044B\u0448\u0443. \u0418 \u0442\u044B \u0434\u043E\u043B\u0436\u0435\u043D
        \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C. \u0415\u0449\u0451 \u0440\u0430\u0437
        \u2014 \u0438 \u043C\u044B \u0440\u044F\u0434\u043E\u043C!"
