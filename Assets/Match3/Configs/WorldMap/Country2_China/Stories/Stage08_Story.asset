  m_Script: {fileID: 11500000, guid: 2b17b268e1fb7734bb975e5058e1bd11, type: 3}
  m_Name: Stage08_Story
  m_EditorClassIdentifier: Assembly-CSharp::Match3.Configs.StageStoryConfig
  <StageSelectStory>k__BackingField:
    <Image>k__BackingField: {fileID: 0}
    <LocalizationId>k__BackingField: china_08_select
    <FallbackText>k__BackingField: "\u041A\u0443\u043D\u044C-\u041B\u0443\u043D\u044C
      \u2014 \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u0430\u044F \u0433\u043E\u0440\u0430,
      \u043C\u0435\u0441\u0442\u043E \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F
      \u041D\u0435\u0444\u0440\u0438\u0442\u043E\u0432\u043E\u0433\u043E \u0414\u0440\u0430\u043A\u043E\u043D\u0430.
      \u041B\u0443\u043D \u0412\u0430\u043D \u0443\u043A\u0440\u0435\u043F\u0438\u043B
      \u0435\u0451 \u043B\u044C\u0434\u043E\u043C \u0438 \u0446\u0435\u043F\u044F\u043C\u0438.
      \u0417\u0434\u0435\u0441\u044C \u043D\u0443\u0436\u043D\u043E \u0441\u043E\u0431\u0440\u0430\u0442\u044C
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u043A\u0430\u043C\u043D\u0438
      \u0441\u0438\u043B\u044B \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C
      \u043C\u0435\u0441\u0442\u043E \u0434\u043B\u044F \u0432\u043E\u0437\u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F
      \u0414\u0440\u0430\u043A\u043E\u043D\u0430."
  <LevelStories>k__BackingField:
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_08_l1_start
      <FallbackText>k__BackingField: "\u041B\u0443\u043D \u0412\u0430\u043D \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u043B\u0441\u044F
        \u2014 \u043B\u0451\u0434 \u0438 \u0446\u0435\u043F\u0438 \u0432\u043C\u0435\u0441\u0442\u0435.
        \u041E\u043D \u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u0447\u0435\u043C
        \u044F \u0434\u0443\u043C\u0430\u043B. \u041D\u043E \u0441\u0438\u043B\u0430
        \u0431\u0435\u0437 \u043C\u0443\u0434\u0440\u043E\u0441\u0442\u0438 \u2014
        \u0441\u043B\u0430\u0431\u043E\u0441\u0442\u044C. \u0410 \u0443 \u043D\u0430\u0441
        \u0435\u0441\u0442\u044C \u043E\u0431\u0430. \u0420\u0430\u0437\u0431\u0438\u0432\u0430\u0435\u043C
        \u043B\u0451\u0434, \u0440\u0432\u0451\u043C \u0446\u0435\u043F\u0438 \u2014
        \u0438 \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u043C \u043A\u0430\u043C\u043D\u0438
        \u0441\u0438\u043B\u044B!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_08_l1_lose
      <FallbackText>k__BackingField: "\u041B\u0443\u043D \u0412\u0430\u043D \u0434\u043E\u0432\u043E\u043B\u0435\u043D.
        \u041F\u0443\u0441\u0442\u044C \u043D\u0435\u0434\u043E\u043B\u0433\u043E.
        \u0415\u0449\u0451 \u0440\u0430\u0437 \u2014 \u043C\u0443\u0434\u0440\u043E\u0441\u0442\u044C
        \u043E\u0441\u0442\u0440\u0435\u0435 \u0435\u0433\u043E \u0441\u0438\u043B\u044B!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_08_l2_start
      <FallbackText>k__BackingField: "\u0413\u043E\u0440\u0430 \u043E\u0442\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F!
        \u041D\u0435\u0444\u0440\u0438\u0442\u043E\u0432\u044B\u0439 \u0414\u0440\u0430\u043A\u043E\u043D
        \u0441\u043F\u0438\u0442 \u0432\u043D\u0443\u0442\u0440\u0438 \u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442
        \u043D\u0430\u0441. \u0427\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435
        \u043A\u0430\u043C\u043D\u0435\u0439 \u0441\u0438\u043B\u044B \u043C\u044B
        \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u043C \u2014 \u0442\u0435\u043C
        \u0431\u043B\u0438\u0436\u0435 \u043F\u0440\u043E\u0431\u0443\u0436\u0434\u0435\u043D\u0438\u0435.
        \u041B\u0443\u043D \u0412\u0430\u043D \u0442\u043E\u0436\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442
        \u0438 \u0437\u043B\u0438\u0442\u0441\u044F. \u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_08_l2_lose
      <FallbackText>k__BackingField: "\u0417\u043B\u043E\u0441\u0442\u044C \u041B\u0443\u043D
        \u0412\u0430\u043D\u0430 \u043C\u0435\u0448\u0430\u0435\u0442. \u041D\u043E
        \u0437\u043B\u043E\u0441\u0442\u044C \u2014 \u044D\u0442\u043E \u0442\u043E\u0436\u0435
        \u0441\u043B\u0430\u0431\u043E\u0441\u0442\u044C. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C
        \u0435\u0451 \u2014 \u0441\u043D\u043E\u0432\u0430!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_08_l3_start
      <FallbackText>k__BackingField: "\u0424\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0435
        \u043A\u0430\u043C\u043D\u0438 \u0443 \u0432\u0435\u0440\u0448\u0438\u043D\u044B
        \u041A\u0443\u043D\u044C-\u041B\u0443\u043D\u044F! \u0413\u043E\u0440\u0430
        \u0434\u0440\u043E\u0436\u0438\u0442 \u2014 \u0414\u0440\u0430\u043A\u043E\u043D
        \u043F\u0440\u043E\u0441\u044B\u043F\u0430\u0435\u0442\u0441\u044F. \u041B\u0443\u043D
        \u0412\u0430\u043D \u043A\u0440\u0438\u0447\u0438\u0442 \u0447\u0442\u043E-\u0442\u043E
        \u043F\u0440\u043E \xAB\u043D\u0435\u0437\u0430\u043A\u043E\u043D\u043D\u043E\u0435
        \u043F\u0440\u043E\u0431\u0443\u0436\u0434\u0435\u043D\u0438\u0435\xBB. \u0421\u043E\u0431\u0435\u0440\u0438
        \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u043A\u0430\u043C\u043D\u0438
        \u2014 \u0438 \u0432\u043E\u0437\u0440\u043E\u0436\u0434\u0435\u043D\u0438\u0435
        \u043D\u0430\u0447\u043D\u0451\u0442\u0441\u044F!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_08_l3_win
      <FallbackText>k__BackingField: "\u041A\u0430\u043C\u043D\u0438 \u0441\u043E\u0431\u0440\u0430\u043D\u044B!
        \u0413\u043E\u0440\u0430 \u0441\u0432\u0435\u0442\u0438\u0442\u0441\u044F
        \u043D\u0435\u0444\u0440\u0438\u0442\u043E\u0432\u044B\u043C \u0441\u0432\u0435\u0442\u043E\u043C...
        \u0414\u0440\u0430\u043A\u043E\u043D \u043F\u0440\u043E\u0441\u044B\u043F\u0430\u0435\u0442\u0441\u044F.
        \u041B\u0443\u043D \u0412\u0430\u043D \u0431\u0435\u0436\u0438\u0442. \u0418\u0434\u0438
        \u0432 \u041D\u0435\u0444\u0440\u0438\u0442\u043E\u0432\u044B\u0439 \u0414\u0432\u043E\u0440\u0435\u0446,
        \u0443\u0447\u0435\u043D\u0438\u043A \u2014 \u0442\u0430\u043C \u0444\u0438\u043D\u0430\u043B
        \u043D\u0430\u0448\u0435\u0433\u043E \u043F\u0443\u0442\u0438."
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_08_l3_lose
      <FallbackText>k__BackingField: "\u0414\u0440\u0430\u043A\u043E\u043D \u043F\u043E\u0447\u0442\u0438
        \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0441\u044F \u2014 \u0435\u0449\u0451
        \u0447\u0443\u0442\u044C-\u0447\u0443\u0442\u044C! \u0424\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0439
        \u0440\u044B\u0432\u043E\u043A \u2014 \u0441\u043D\u043E\u0432\u0430!"
