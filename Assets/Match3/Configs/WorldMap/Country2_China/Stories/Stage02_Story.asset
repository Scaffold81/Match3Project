  m_Name: Stage02_Story
  m_EditorClassIdentifier: Assembly-CSharp::Match3.Configs.StageStoryConfig
  <StageSelectStory>k__BackingField:
    <Image>k__BackingField: {fileID: 0}
    <LocalizationId>k__BackingField: china_02_select
    <FallbackText>k__BackingField: "\u0411\u0430\u043C\u0431\u0443\u043A\u043E\u0432\u044B\u0439
      \u043B\u0435\u0441 \u2014 \u043E\u043D \u043A\u0430\u0436\u0435\u0442\u0441\u044F
      \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u043C \u0432 \u043B\u044E\u0431\u043E\u043C
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438. \u042D\u0442\u043E
      \u043D\u0435 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u043A,
      \u044D\u0442\u043E \u0443\u0440\u043E\u043A: \u0446\u0435\u043B\u044C \u043E\u0434\u043D\u0430,
      \u043F\u0443\u0442\u0435\u0439 \u043C\u043D\u043E\u0433\u043E. \u0412\u0442\u043E\u0440\u043E\u0439
      \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442 \u0414\u0440\u0430\u043A\u043E\u043D\u0430
      \u0437\u0434\u0435\u0441\u044C. \u041E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u0443\u0439\u0441\u044F
      \u043F\u043E \u0446\u0432\u0435\u0442\u0443 \u2014 \u0438 \u043D\u0435 \u0442\u0435\u0440\u044F\u0439
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435."
  <LevelStories>k__BackingField:
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_02_l1_start
      <FallbackText>k__BackingField: "\u0411\u0430\u043C\u0431\u0443\u043A \u0440\u0430\u0441\u0442\u0451\u0442
        \u0431\u044B\u0441\u0442\u0440\u043E \u2014 \u0431\u044B\u0441\u0442\u0440\u0435\u0435
        \u043B\u044E\u0431\u043E\u0433\u043E \u0434\u0435\u0440\u0435\u0432\u0430.
        \u041E\u043D \u0443\u0447\u0438\u0442 \u043D\u0430\u0441 \u0433\u0438\u0431\u043A\u043E\u0441\u0442\u0438.
        \u041A\u0430\u043C\u043D\u0438 \u0437\u0434\u0435\u0441\u044C \u0442\u043E\u0436\u0435
        \u0433\u0438\u0431\u043A\u043E \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u044B
        \u2014 \u0441\u043E\u0431\u0438\u0440\u0430\u0439 \u043C\u0430\u0442\u0447\u0438
        \u0432 \u0442\u043E\u043C \u043F\u043E\u0440\u044F\u0434\u043A\u0435 \u043A\u043E\u0442\u043E\u0440\u044B\u0439
        \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
        \u043B\u0435\u0441, \u043D\u0435 \u0442\u043E\u0442 \u043A\u043E\u0442\u043E\u0440\u044B\u0439
        \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u044B\u043C."
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_02_l1_lose
      <FallbackText>k__BackingField: "\u041B\u0435\u0441 \u0437\u0430\u043F\u0443\u0442\u0430\u043B?
        \u042D\u0442\u043E \u0435\u0433\u043E \u043F\u0440\u0438\u0440\u043E\u0434\u0430.
        \u041D\u0435 \u0431\u043E\u0440\u0438\u0441\u044C \u0441 \u043D\u0438\u043C
        \u2014 \u0438\u0434\u0438 \u0432\u043C\u0435\u0441\u0442\u0435. \u0415\u0449\u0451
        \u0440\u0430\u0437!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_02_l2_start
      <FallbackText>k__BackingField: "\u0421\u043B\u044B\u0448\u0438\u0448\u044C
        \u043A\u0430\u043A \u0442\u0440\u0435\u0449\u0438\u0442 \u0431\u0430\u043C\u0431\u0443\u043A
        \u043D\u0430 \u0432\u0435\u0442\u0440\u0443? \u042D\u0442\u043E \u043C\u0443\u0437\u044B\u043A\u0430
        \u043B\u0435\u0441\u0430. \u0412\u0442\u043E\u0440\u043E\u0439 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442
        \u0414\u0440\u0430\u043A\u043E\u043D\u0430 \u0440\u0435\u0437\u043E\u043D\u0438\u0440\u0443\u0435\u0442
        \u0441 \u044D\u0442\u0438\u043C \u0437\u0432\u0443\u043A\u043E\u043C \u2014
        \u0447\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u043A\u0430\u043C\u043D\u0435\u0439
        \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0448\u044C, \u0442\u0435\u043C
        \u043E\u0442\u0447\u0451\u0442\u043B\u0438\u0432\u0435\u0435 \u0437\u0432\u0443\u043A.
        \u0421\u043B\u0435\u0434\u0443\u0439 \u0437\u0430 \u043D\u0438\u043C."
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_02_l2_lose
      <FallbackText>k__BackingField: "\u041C\u0443\u0437\u044B\u043A\u0430 \u043F\u0440\u0435\u0440\u0432\u0430\u043B\u0430\u0441\u044C.
        \u0417\u043D\u0430\u0447\u0438\u0442 \u043C\u044B \u0441\u0431\u0438\u043B\u0438\u0441\u044C
        \u0441 \u043F\u0443\u0442\u0438. \u041D\u0430\u0439\u0434\u0451\u043C \u0435\u0433\u043E
        \u0441\u043D\u043E\u0432\u0430 \u2014 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u043C\u0441\u044F!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_02_l3_start
      <FallbackText>k__BackingField: "\u0426\u0435\u043D\u0442\u0440 \u043B\u0435\u0441\u0430!
        \u0417\u0434\u0435\u0441\u044C \u0441\u0430\u043C\u044B\u0439 \u0441\u0442\u0430\u0440\u044B\u0439
        \u0431\u0430\u043C\u0431\u0443\u043A \u2014 \u0435\u043C\u0443 \u043F\u044F\u0442\u044C\u0441\u043E\u0442
        \u043B\u0435\u0442. \u0424\u0440\u0430\u0433\u043C\u0435\u043D\u0442 \u0414\u0440\u0430\u043A\u043E\u043D\u0430
        \u043B\u0435\u0436\u0438\u0442 \u0443 \u0435\u0433\u043E \u043A\u043E\u0440\u043D\u0435\u0439.
        \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u043A\u0430\u043C\u043D\u0438
        \u0437\u0434\u0435\u0441\u044C \u2014 \u0441\u043E\u0431\u0435\u0440\u0438
        \u0438\u0445, \u0438 \u043B\u0435\u0441 \u0441\u0430\u043C \u0443\u043A\u0430\u0436\u0435\u0442
        \u043F\u0443\u0442\u044C \u043A \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u0443."
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_02_l3_win
      <FallbackText>k__BackingField: "\u0412\u0442\u043E\u0440\u043E\u0439 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442!
        \u0414\u0440\u0430\u043A\u043E\u043D \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
        \u0442\u0435\u043F\u043B\u0435\u0435 \u2014 \u0443\u0436\u0435 \u043F\u043E\u0447\u0442\u0438
        \u0433\u043E\u0440\u044F\u0447\u0438\u0439. \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
        \u043F\u0443\u0442\u044C \u043B\u0435\u0436\u0438\u0442 \u0447\u0435\u0440\u0435\u0437
        \u0433\u043E\u0440\u044B \u2014 \u0442\u0430\u043C \u0445\u043E\u043B\u043E\u0434
        \u0438 \u043B\u0451\u0434. \u0413\u043E\u0442\u043E\u0432\u044C\u0441\u044F,
        \u0443\u0447\u0435\u043D\u0438\u043A."
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: china_02_l3_lose
      <FallbackText>k__BackingField: "\u041A\u043E\u0440\u043D\u0438 \u0434\u0435\u0440\u0436\u0430\u0442
        \u0442\u0430\u0439\u043D\u0443 \u043A\u0440\u0435\u043F\u043A\u043E. \u0423\u0432\u0430\u0436\u0435\u043D\u0438\u0435
        \u043A \u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u0438 \u2014 \u0438
        \u0435\u0449\u0451 \u043E\u0434\u043D\u0430 \u043F\u043E\u043F\u044B\u0442\u043A\u0430!"
