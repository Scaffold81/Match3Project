  m_Script: {fileID: 11500000, guid: 2b17b268e1fb7734bb975e5058e1bd11, type: 3}
  m_Name: Stage05_Story
  m_EditorClassIdentifier: Assembly-CSharp::Match3.Configs.StageStoryConfig
  <StageSelectStory>k__BackingField:
    <Image>k__BackingField: {fileID: 0}
    <LocalizationId>k__BackingField: india_05_select
    <FallbackText>k__BackingField: "\u0414\u0435\u043B\u0438 \u2014 \u0441\u0442\u043E\u043B\u0438\u0446\u0430!
      \u041A\u0430\u043B\u0438 \u0441\u043F\u0440\u044F\u0442\u0430\u043B \u043F\u044F\u0442\u044B\u0439
      \u043B\u0435\u043F\u0435\u0441\u0442\u043E\u043A \u0432 \u0414\u0436\u0430\u043C\u0430-\u041C\u0430\u0441\u0434\u0436\u0438\u0434
      \u2014 \u0432\u0435\u043B\u0438\u043A\u043E\u0439 \u043C\u0435\u0447\u0435\u0442\u0438.
      \u041A\u0430\u043C\u0435\u043D\u043D\u044B\u0435 \u044F\u0449\u0438\u043A\u0438
      \u0437\u0430\u0433\u0440\u043E\u043C\u043E\u0437\u0434\u0438\u043B\u0438 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439
      \u0434\u0432\u043E\u0440. \u0420\u0430\u0441\u0447\u0438\u0441\u0442\u0438\u043C
      \u0434\u0432\u043E\u0440 \u0438 \u043D\u0430\u0439\u0434\u0451\u043C \u043B\u0435\u043F\u0435\u0441\u0442\u043E\u043A.
      \u0423\u0432\u0430\u0436\u0430\u044F \u043C\u0435\u0441\u0442\u043E."
  <LevelStories>k__BackingField:
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_05_l1_start
      <FallbackText>k__BackingField: "\u0412\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439
        \u0434\u0432\u043E\u0440 \u043C\u0435\u0447\u0435\u0442\u0438 \u2014 \u043C\u0435\u0441\u0442\u043E
        \u043F\u043E\u043A\u043E\u044F \u0434\u043B\u044F \u0442\u044B\u0441\u044F\u0447
        \u043B\u044E\u0434\u0435\u0439. \u042F\u0449\u0438\u043A\u0438 \u0437\u0434\u0435\u0441\u044C
        \u043D\u0435\u0443\u043C\u0435\u0441\u0442\u043D\u044B \u2014 \u044D\u0442\u043E
        \u0440\u0430\u0431\u043E\u0442\u0430 \u041A\u0430\u043B\u0438, \u043D\u0435
        \u0445\u043E\u0437\u044F\u0435\u0432. \u0420\u0430\u0437\u0431\u0438\u0440\u0430\u0435\u043C
        \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E \u0438 \u0438\u0449\u0435\u043C
        \u043B\u0435\u043F\u0435\u0441\u0442\u043E\u043A \u0441\u0440\u0435\u0434\u0438
        \u0441\u0442\u0430\u0440\u0438\u043D\u043D\u044B\u0445 \u043F\u043B\u0438\u0442."
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_05_l1_lose
      <FallbackText>k__BackingField: "\u041F\u043E\u043A\u043E\u0439 \u043D\u0430\u0440\u0443\u0448\u0435\u043D.
        \u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043C \u0438
        \u0435\u0433\u043E, \u0438 \u043D\u0430\u0448 \u043F\u0443\u0442\u044C \u2014
        \u0441\u043D\u043E\u0432\u0430!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_05_l2_start
      <FallbackText>k__BackingField: "\u041C\u0438\u043D\u0430\u0440\u0435\u0442!
        \u041A\u0430\u043B\u0438 \u0437\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043B
        \u043F\u043E\u0434\u0445\u043E\u0434 \u043A \u043C\u0438\u043D\u0430\u0440\u0435\u0442\u0443
        \u044F\u0449\u0438\u043A\u0430\u043C\u0438 \u2014 \u0442\u0430\u043C \u0447\u0442\u043E-\u0442\u043E
        \u0432\u0430\u0436\u043D\u043E\u0435. \u041B\u0435\u043F\u0435\u0441\u0442\u043E\u043A
        \u0438\u043B\u0438 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430
        \u043A \u043D\u0435\u043C\u0443. \u0420\u0430\u0437\u0431\u0438\u0440\u0430\u0435\u043C
        \u044F\u0449\u0438\u043A\u0438 \u0438 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u043C\u0441\u044F
        \u0432\u044B\u0448\u0435."
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_05_l2_lose
      <FallbackText>k__BackingField: "\u041C\u0438\u043D\u0430\u0440\u0435\u0442
        \u0432\u044B\u0441\u043E\u043A, \u044F\u0449\u0438\u043A\u0438 \u0442\u044F\u0436\u0435\u043B\u044B.
        \u041D\u043E \u043C\u044B \u0443\u043F\u043E\u0440\u043D\u0435\u0435 \u2014
        \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F \u043F\u043E\u043F\u044B\u0442\u043A\u0430!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_05_l3_start
      <FallbackText>k__BackingField: "\u0413\u043B\u0430\u0432\u043D\u044B\u0439
        \u043F\u043E\u0440\u0442\u0430\u043B \u043C\u0435\u0447\u0435\u0442\u0438!
        \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u044F\u0449\u0438\u043A\u0438
        \u0437\u0434\u0435\u0441\u044C \u2014 \u0438 \u0437\u0430 \u043D\u0438\u043C\u0438
        \u0441\u0438\u044F\u0435\u0442 \u043F\u044F\u0442\u044B\u0439 \u043B\u0435\u043F\u0435\u0441\u0442\u043E\u043A.
        \u0417\u0435\u043B\u0451\u043D\u044B\u0439 \u043A\u0430\u043A \u043B\u0438\u0441\u0442\u044C\u044F
        \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u043E\u0433\u043E \u0434\u0435\u0440\u0435\u0432\u0430.
        \u0420\u0430\u0437\u0431\u0438\u0432\u0430\u0435\u043C \u2014 \u0438 \u043E\u043D
        \u043D\u0430\u0448!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_05_l3_win
      <FallbackText>k__BackingField: "\u041F\u044F\u0442\u044B\u0439 \u043B\u0435\u043F\u0435\u0441\u0442\u043E\u043A,
        \u0437\u0435\u043B\u0451\u043D\u044B\u0439! \u041E\u043D \u043F\u0430\u0445
        \u0436\u0430\u0441\u043C\u0438\u043D\u043E\u043C \u043A\u043E\u0433\u0434\u0430
        \u044F \u0432\u0437\u044F\u043B \u0435\u0433\u043E \u0432 \u0440\u0443\u043A\u0438.
        \u041A\u0430\u043B\u0438... \u044F \u0443\u0436\u0435 \u043F\u043E\u0447\u0442\u0438
        \u043F\u043E\u043D\u0438\u043C\u0430\u044E \u0442\u0435\u0431\u044F. \u0417\u0430\u0432\u0438\u0441\u0442\u044C
        \u2014 \u0441\u0442\u0440\u0430\u0448\u043D\u0430\u044F \u0432\u0435\u0449\u044C.
        \u041D\u043E \u044F \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u0445\u043E\u0447\u0443
        \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u043A\u043E\u0440\u043E\u043D\u0443.
        \u0414\u0432\u0430 \u043B\u0435\u043F\u0435\u0441\u0442\u043A\u0430 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C!"
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_05_l3_lose
      <FallbackText>k__BackingField: "\u041F\u043E\u0440\u0442\u0430\u043B \u0434\u0435\u0440\u0436\u0438\u0442
        \u043B\u0435\u043F\u0435\u0441\u0442\u043E\u043A. \u041D\u043E \u043D\u0435
        \u0432\u0435\u0447\u043D\u043E \u2014 \u0435\u0449\u0451 \u0440\u0430\u0437!"
