  m_Name: Stage04_Story
  m_EditorClassIdentifier: Assembly-CSharp::Match3.Configs.StageStoryConfig
  <StageSelectStory>k__BackingField:
    <Image>k__BackingField: {fileID: 0}
    <LocalizationId>k__BackingField: india_04_select
    <FallbackText>k__BackingField: "\u041A\u0445\u0430\u0434\u0436\u0443\u0440\u0430\u0445\u043E
      \u2014 \u0445\u0440\u0430\u043C\u044B \u043F\u043E\u0441\u0432\u044F\u0449\u0451\u043D\u043D\u044B\u0435
      \u0433\u0430\u0440\u043C\u043E\u043D\u0438\u0438. \u041A\u0430\u043B\u0438
      \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u043B \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u044B\u0439
      \u043B\u0435\u043F\u0435\u0441\u0442\u043E\u043A \u0447\u0435\u0442\u044B\u0440\u044C\u043C\u044F
      \u043B\u0435\u0434\u044F\u043D\u044B\u043C\u0438 \u0437\u0430\u043C\u043A\u0430\u043C\u0438.
      \u0427\u0435\u0442\u044B\u0440\u0435 \u0437\u0430\u043C\u043A\u0430 \u2014
      \u0447\u0435\u0442\u044B\u0440\u0435 \u0441\u0442\u043E\u0440\u043E\u043D\u044B
      \u0441\u0432\u0435\u0442\u0430 \u2014 \u0447\u0435\u0442\u044B\u0440\u0435
      \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F. \u041D\u0430\u0447\u0438\u043D\u0430\u0435\u043C!"
  <LevelStories>k__BackingField:
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_04_l1_start
      <FallbackText>k__BackingField: "\u0421\u0435\u0432\u0435\u0440\u043D\u044B\u0439
        \u0437\u0430\u043C\u043E\u043A \u2014 \u043F\u0435\u0440\u0432\u043E\u0435
        \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435. \u041A\u0430\u043B\u0438
        \u0434\u0443\u043C\u0430\u043B \u0447\u0442\u043E \u044F \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u044E\u0441\u044C
        \u0443\u0436\u0435 \u0437\u0434\u0435\u0441\u044C. \u041E\u043D \u043D\u0435
        \u0437\u043D\u0430\u0435\u0442 \u043C\u0435\u043D\u044F. \u0418 \u043D\u0435
        \u0437\u043D\u0430\u0435\u0442 \u0442\u0435\u0431\u044F! \u0420\u0430\u0437\u0431\u0438\u0432\u0430\u0435\u043C
        \u0441\u0435\u0432\u0435\u0440\u043D\u044B\u0439 \u043B\u0451\u0434 \u0438
        \u0438\u0434\u0451\u043C \u043F\u043E \u0447\u0430\u0441\u043E\u0432\u043E\u0439
        \u0441\u0442\u0440\u0435\u043B\u043A\u0435 \u2014 \u043A\u0430\u043A \u0441\u043E\u043B\u043D\u0446\u0435."
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_04_l1_lose
      <FallbackText>k__BackingField: "\u0421\u043E\u043B\u043D\u0446\u0435 \u0442\u043E\u0436\u0435
        \u0438\u043D\u043E\u0433\u0434\u0430 \u043F\u0440\u044F\u0447\u0435\u0442\u0441\u044F
        \u0437\u0430 \u043E\u0431\u043B\u0430\u043A\u0430. \u042D\u0442\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E.
        \u0421\u043D\u043E\u0432\u0430!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_04_l2_start
      <FallbackText>k__BackingField: "\u0414\u0432\u0430 \u0437\u0430\u043C\u043A\u0430
        \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u044B! \u0425\u0440\u0430\u043C\u044B
        \u0441\u0430\u043C\u0438 \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442
        \u043D\u0430\u043C \u2014 \u0432\u0438\u0434\u0438\u0448\u044C \u043A\u0430\u043A
        \u043A\u0430\u043C\u043D\u0438 \u043A \u043D\u0430\u043C \u0442\u044F\u043D\u0443\u0442\u0441\u044F?
        \u0413\u0430\u0440\u043C\u043E\u043D\u0438\u044F \u043D\u0430 \u043D\u0430\u0448\u0435\u0439
        \u0441\u0442\u043E\u0440\u043E\u043D\u0435. \u0415\u0449\u0451 \u0434\u0432\u0430
        \u0437\u0430\u043C\u043A\u0430 \u2014 \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u044B\u0439
        \u0438 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0439."
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_04_l2_lose
      <FallbackText>k__BackingField: "\u0413\u0430\u0440\u043C\u043E\u043D\u0438\u044F
        \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0430. \u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043C
        \u2014 \u0435\u0449\u0451 \u0440\u0430\u0437!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_04_l3_start
      <FallbackText>k__BackingField: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
        \u0434\u0432\u0430 \u0437\u0430\u043C\u043A\u0430 \u2014 \u044E\u0436\u043D\u044B\u0439
        \u0438 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0439.
        \u0427\u0435\u0442\u0432\u0451\u0440\u0442\u044B\u0439 \u043B\u0435\u043F\u0435\u0441\u0442\u043E\u043A
        \u043F\u0443\u043B\u044C\u0441\u0438\u0440\u0443\u0435\u0442 \u0432\u043D\u0443\u0442\u0440\u0438
        \u2014 \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u044B\u0439 \u043A\u0430\u043A
        \u0437\u0430\u043A\u0430\u0442! \u0421\u043E\u0431\u0435\u0440\u0451\u043C
        \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u043A\u0430\u043C\u043D\u0438
        \u2014 \u0438 \u0433\u0430\u0440\u043C\u043E\u043D\u0438\u044F \u041A\u0445\u0430\u0434\u0436\u0443\u0440\u0430\u0445\u043E
        \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_04_l3_win
      <FallbackText>k__BackingField: "\u0427\u0435\u0442\u0432\u0451\u0440\u0442\u044B\u0439
        \u043B\u0435\u043F\u0435\u0441\u0442\u043E\u043A \u2014 \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u044B\u0439,
        \u0442\u0451\u043F\u043B\u044B\u0439, \u0436\u0438\u0432\u043E\u0439! \u0415\u0449\u0451
        \u0442\u0440\u0438 \u2014 \u0438 \u043A\u043E\u0440\u043E\u043D\u0430 \u043C\u043E\u044F.
        \u041B\u0435\u0442\u0438\u043C \u043D\u0430 \u044E\u0433!"
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_04_l3_lose
      <FallbackText>k__BackingField: "\u042E\u0436\u043D\u044B\u0439 \u0438 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0439
        \u0437\u0430\u043C\u043A\u0438 \u0434\u0435\u0440\u0436\u0430\u0442\u0441\u044F.
        \u041F\u0443\u0441\u0442\u044C \u043D\u0435\u0434\u043E\u043B\u0433\u043E
        \u2014 \u0435\u0449\u0451 \u0440\u0430\u0437!"
