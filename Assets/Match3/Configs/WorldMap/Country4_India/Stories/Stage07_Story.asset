  m_Script: {fileID: 11500000, guid: 2b17b268e1fb7734bb975e5058e1bd11, type: 3}
  m_Name: Stage07_Story
  m_EditorClassIdentifier: Assembly-CSharp::Match3.Configs.StageStoryConfig
  <StageSelectStory>k__BackingField:
    <Image>k__BackingField: {fileID: 0}
    <LocalizationId>k__BackingField: india_07_select
    <FallbackText>k__BackingField: "\u0413\u043E\u0430 \u2014 \u0431\u0435\u0440\u0435\u0433
      \u043C\u043E\u0440\u044F, \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435
      \u043C\u0435\u0441\u0442\u043E. \u041A\u0430\u043B\u0438 \u0431\u0435\u0436\u0430\u043B
      \u0441\u044E\u0434\u0430 \u0441 \u0441\u0435\u0434\u044C\u043C\u044B\u043C
      \u043B\u0435\u043F\u0435\u0441\u0442\u043A\u043E\u043C. \u041B\u0451\u0434
      \u0438 \u0446\u0435\u043F\u0438 \u2014 \u043E\u043D \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B
      \u0432\u0441\u0451 \u0447\u0442\u043E \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C.
      \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u043B\u0435\u043F\u0435\u0441\u0442\u043E\u043A
      \u2014 \u0438 \u041B\u043E\u0442\u043E\u0441 \u0418\u043D\u0434\u0440\u044B
      \u0441\u043D\u043E\u0432\u0430 \u0446\u0435\u043B\u044B\u0439!"
  <LevelStories>k__BackingField:
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_07_l1_start
      <FallbackText>k__BackingField: "\u041A\u0430\u043B\u0438 \u043D\u0430 \u0431\u0435\u0440\u0435\u0433\u0443!
        \u042F \u0432\u0438\u0436\u0443 \u0435\u0433\u043E \u0441\u043B\u0435\u0434\u044B
        \u2014 \u043B\u0451\u0434 \u0442\u0430\u043C \u0433\u0434\u0435 \u043D\u0435
        \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C \u043B\u044C\u0434\u0430
        \u0443 \u0442\u0440\u043E\u043F\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
        \u043C\u043E\u0440\u044F. \u041E\u043D \u0431\u0435\u0436\u0430\u043B \u0432\u043F\u043E\u043F\u044B\u0445\u0430\u0445
        \u2014 \u043D\u0435 \u0442\u0430\u043A \u0442\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u043E
        \u0440\u0430\u0441\u0441\u0442\u0430\u0432\u0438\u043B \u043F\u0440\u0435\u0433\u0440\u0430\u0434\u044B.
        \u0415\u0433\u043E \u0441\u043B\u0430\u0431\u043E\u0441\u0442\u044C \u2014
        \u043D\u0430\u0448 \u0448\u0430\u043D\u0441. \u0412\u043F\u0435\u0440\u0451\u0434!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_07_l1_lose
      <FallbackText>k__BackingField: "\u041A\u0430\u043B\u0438 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
        \u0442\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u0435\u0435 \u0447\u0435\u043C
        \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C. \u0423\u0432\u0430\u0436\u0435\u043D\u0438\u0435
        \u2014 \u0438 \u0441\u043D\u043E\u0432\u0430!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_07_l2_start
      <FallbackText>k__BackingField: "\u0426\u0435\u0440\u043A\u043E\u0432\u044C
        \u0411\u043E\u043C \u0416\u0435\u0437\u0443\u0441 \u2014 \u0437\u0434\u0435\u0441\u044C
        \u043F\u043E\u043A\u043E\u044F\u0442\u0441\u044F \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u0438
        \u0441\u0432\u044F\u0442\u043E\u0433\u043E \u0424\u0440\u0430\u043D\u0446\u0438\u0441\u043A\u0430.
        \u041A\u0430\u043B\u0438 \u0441\u043F\u0440\u044F\u0442\u0430\u043B\u0441\u044F
        \u0432 \u0435\u0451 \u0442\u0435\u043D\u0438. \u041B\u043E\u043C\u0430\u0435\u043C
        \u0446\u0435\u043F\u0438 \u0443 \u0432\u0445\u043E\u0434\u0430 \u2014 \u0438
        \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u043B\u0435\u043F\u0435\u0441\u0442\u043E\u043A
        \u0431\u043B\u0438\u0437\u043A\u043E. \u0424\u0438\u043D\u0430\u043B \u044D\u0442\u043E\u0433\u043E
        \u043F\u0443\u0442\u0438!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_07_l2_lose
      <FallbackText>k__BackingField: "\u0422\u0435\u043D\u044C \u041A\u0430\u043B\u0438
        \u0435\u0449\u0451 \u0434\u043B\u0438\u043D\u043D\u0430\u044F. \u041D\u043E
        \u0441\u043E\u043B\u043D\u0446\u0435 \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044F
        \u2014 \u0438 \u043C\u044B \u0442\u043E\u0436\u0435. \u0421\u043D\u043E\u0432\u0430!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_07_l3_start
      <FallbackText>k__BackingField: "\u0411\u0435\u0440\u0435\u0433! \u041A\u0430\u043B\u0438
        \u0441\u0442\u043E\u0438\u0442 \u0443 \u0432\u043E\u0434\u044B \u0438 \u0434\u0435\u0440\u0436\u0438\u0442
        \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u043B\u0435\u043F\u0435\u0441\u0442\u043E\u043A.
        \u041B\u0451\u0434 \u0438 \u0446\u0435\u043F\u0438 \u2014 \u0435\u0433\u043E
        \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u0430\u044F \u0437\u0430\u0449\u0438\u0442\u0430.
        \u0420\u0430\u0437\u0431\u0435\u0439 \u0438\u0445 \u2014 \u0438 \u043B\u0435\u043F\u0435\u0441\u0442\u043E\u043A
        \u0443\u043F\u0430\u0434\u0451\u0442. \u041A\u0430\u043B\u0438... \u044F
        \u0443\u0436\u0435 \u043D\u0435 \u0437\u043B\u044E\u0441\u044C. \u041F\u0440\u043E\u0441\u0442\u043E
        \u0445\u043E\u0447\u0443 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C
        \u044D\u0442\u043E."
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_07_l3_win
      <FallbackText>k__BackingField: "\u0421\u0415\u0414\u042C\u041C\u041E\u0419
        \u041B\u0415\u041F\u0415\u0421\u0422\u041E\u041A! \u041B\u041E\u0422\u041E\u0421
        \u0418\u041D\u0414\u0420\u042B \u0426\u0415\u041B\u042B\u0419! \u041A\u0430\u043B\u0438
        \u043F\u0430\u0434\u0430\u0435\u0442 \u043D\u0430 \u043A\u043E\u043B\u0435\u043D\u0438...
        \u0438 \u043F\u043B\u0430\u0447\u0435\u0442. \u041E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442:
        \xAB\u042F \u0445\u043E\u0442\u0435\u043B \u0441\u0442\u0430\u0442\u044C
        \u0432\u0430\u0436\u043D\u044B\u043C. \u042F \u043D\u0435 \u0437\u043D\u0430\u043B
        \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u0441\u043F\u043E\u0441\u043E\u0431\u0430\xBB.
        \u042F \u0441\u043C\u043E\u0442\u0440\u044E \u043D\u0430 \u043D\u0435\u0433\u043E...
        \u0438 \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u044E \u0440\u0443\u043A\u0443.
        \u041F\u043E\u0439\u0434\u0451\u043C \u043D\u0430 \u043A\u043E\u0440\u043E\u043D\u0430\u0446\u0438\u044E
        \u0432\u043C\u0435\u0441\u0442\u0435 \u2014 \u043A\u0430\u043A \u0441\u043E\u0432\u0435\u0442\u043D\u0438\u043A."
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_07_l3_lose
      <FallbackText>k__BackingField: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
        \u043B\u0435\u043F\u0435\u0441\u0442\u043E\u043A! \u0422\u0430\u043A \u0431\u043B\u0438\u0437\u043A\u043E!
        \u0424\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0439 \u0440\u044B\u0432\u043E\u043A
        \u2014 \u0441\u043D\u043E\u0432\u0430!"
