  <StageSelectStory>k__BackingField:
    <Image>k__BackingField: {fileID: 0}
    <LocalizationId>k__BackingField: india_06_select
    <FallbackText>k__BackingField: "\u041C\u0430\u0439\u0441\u0443\u0440 \u2014 \u0434\u0432\u043E\u0440\u0435\u0446
      \u0441 \u0442\u044B\u0441\u044F\u0447\u044C\u044E \u043A\u043E\u043C\u043D\u0430\u0442!
      \u0428\u0435\u0441\u0442\u043E\u0439 \u043B\u0435\u043F\u0435\u0441\u0442\u043E\u043A
      \u0433\u0434\u0435-\u0442\u043E \u0432\u043D\u0443\u0442\u0440\u0438. \u041A\u0430\u043B\u0438
      \u043E\u043F\u0443\u0442\u0430\u043B \u0432\u0435\u0441\u044C \u0434\u0432\u043E\u0440\u0435\u0446
      \u0446\u0435\u043F\u044F\u043C\u0438 \u2014 \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E.
      \u0427\u0435\u0442\u044B\u0440\u0435 \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0445
      \u0446\u0435\u043F\u043D\u044B\u0445 \u0437\u0430\u043C\u043A\u0430 \u0437\u0430\u043F\u0438\u0440\u0430\u044E\u0442
      \u0433\u043B\u0430\u0432\u043D\u044B\u0435 \u0437\u0430\u043B\u044B. \u0420\u0430\u0437\u0440\u044B\u0432\u0430\u0435\u043C
      \u0446\u0435\u043F\u0438!"
  <LevelStories>k__BackingField:
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_06_l1_start
      <FallbackText>k__BackingField: "\u0422\u044B\u0441\u044F\u0447\u0430 \u043A\u043E\u043C\u043D\u0430\u0442
        \u0438 \u0447\u0435\u0442\u044B\u0440\u0435 \u0433\u043B\u0430\u0432\u043D\u044B\u0445
        \u0446\u0435\u043F\u0438. \u041D\u0430\u0447\u043D\u0451\u043C \u0441 \u0442\u043E\u0439
        \u0447\u0442\u043E \u0443 \u043F\u0430\u0440\u0430\u0434\u043D\u043E\u0433\u043E
        \u0432\u0445\u043E\u0434\u0430 \u2014 \u043E\u043D\u0430 \u0441\u0430\u043C\u0430\u044F
        \u0432\u0438\u0434\u0438\u043C\u0430\u044F. \u041A\u0430\u043B\u0438 \u0441\u0434\u0435\u043B\u0430\u043B
        \u0435\u0451 \u0441\u0430\u043C\u043E\u0439 \u0437\u0430\u043C\u0435\u0442\u043D\u043E\u0439
        \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u043F\u0443\u0433\u0430\u0442\u044C.
        \u041D\u0435 \u043D\u0430\u043F\u0443\u0433\u0430\u043B! \u0420\u0432\u0451\u043C
        \u043F\u0435\u0440\u0432\u0443\u044E!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_06_l1_lose
      <FallbackText>k__BackingField: "\u0426\u0435\u043F\u044C \u043D\u0435 \u043F\u043E\u0434\u0434\u0430\u043B\u0430\u0441\u044C.
        \u041A\u0430\u043B\u0438 \u043D\u0435 \u0437\u0440\u044F \u0432\u044B\u0431\u0440\u0430\u043B
        \u0435\u0451 \u0434\u043B\u044F \u0432\u0445\u043E\u0434\u0430. \u041D\u043E
        \u043C\u044B \u043F\u0440\u043E\u0448\u043B\u0438 \u043F\u044F\u0442\u044C
        \u043B\u0435\u043F\u0435\u0441\u0442\u043A\u043E\u0432 \u2014 \u043F\u0440\u043E\u0439\u0434\u0451\u043C
        \u0438 \u0448\u0435\u0441\u0442\u043E\u0439. \u0421\u043D\u043E\u0432\u0430!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_06_l2_start
      <FallbackText>k__BackingField: "\u0417\u0430\u043B \u0421\u043B\u043E\u043D\u043E\u0432!
        \u0417\u0434\u0435\u0441\u044C \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043B\u0438
        \u0446\u0435\u0440\u0435\u043C\u043E\u043D\u0438\u0438 \u043A\u043E\u0440\u043E\u043D\u0430\u0446\u0438\u0438...
        \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u0442\u0443 \u043A\u043E\u0442\u043E\u0440\u0443\u044E
        \u044F \u0436\u0434\u0443. \u0426\u0435\u043F\u0438 \u0437\u0434\u0435\u0441\u044C
        \u0432 \u0434\u0432\u0430 \u0441\u043B\u043E\u044F \u2014 \u041A\u0430\u043B\u0438
        \u0437\u043D\u0430\u043B \u0447\u0442\u043E \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E
        \u043C\u043D\u0435 \u0432\u0430\u0436\u043D\u043E. \u0422\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435
        \u043F\u0440\u0438\u0447\u0438\u043D \u0440\u0430\u0437\u043E\u0440\u0432\u0430\u0442\u044C
        \u0438\u0445!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_06_l2_lose
      <FallbackText>k__BackingField: "\u0417\u0430\u043B \u0421\u043B\u043E\u043D\u043E\u0432
        \u0436\u0434\u0451\u0442 \u043C\u0435\u043D\u044F. \u042F \u0442\u043E\u0436\u0435
        \u0436\u0434\u0443 \u2014 \u0438 \u044D\u0442\u043E \u043F\u0440\u0438\u0434\u0430\u0451\u0442
        \u0441\u0438\u043B\u044B. \u0421\u043D\u043E\u0432\u0430!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_06_l3_start
      <FallbackText>k__BackingField: "\u0422\u0440\u043E\u043D\u043D\u044B\u0439
        \u0437\u0430\u043B \u041C\u0430\u0439\u0441\u0443\u0440\u0430! \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
        \u0446\u0435\u043F\u0438 \u0437\u0434\u0435\u0441\u044C \u2014 \u0438 \u0448\u0435\u0441\u0442\u043E\u0439
        \u043B\u0435\u043F\u0435\u0441\u0442\u043E\u043A \u043D\u0430 \u0441\u0430\u043C\u043E\u043C
        \u0442\u0440\u043E\u043D\u0435. \u041A\u0430\u043B\u0438 \u043F\u043E\u0441\u0430\u0434\u0438\u043B
        \u0435\u0433\u043E \u043D\u0430 \u0447\u0443\u0436\u043E\u0439 \u0442\u0440\u043E\u043D
        \u2014 \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0447\u043D\u043E \u0438
        \u043E\u0431\u0438\u0434\u043D\u043E. \u0420\u0432\u0451\u043C \u0446\u0435\u043F\u0438
        \u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u043C \u043B\u0435\u043F\u0435\u0441\u0442\u043E\u043A
        \u0442\u0443\u0434\u0430 \u0433\u0434\u0435 \u0435\u043C\u0443 \u043C\u0435\u0441\u0442\u043E!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_06_l3_win
      <FallbackText>k__BackingField: "\u0428\u0435\u0441\u0442\u043E\u0439 \u043B\u0435\u043F\u0435\u0441\u0442\u043E\u043A
        \u2014 \u0444\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u044B\u0439! \u0426\u0432\u0435\u0442
        \u0446\u0430\u0440\u0441\u043A\u043E\u0439 \u043C\u0443\u0434\u0440\u043E\u0441\u0442\u0438!
        \u041A\u0430\u043B\u0438... \u0442\u044B \u0441\u043F\u0440\u044F\u0442\u0430\u043B
        \u0435\u0433\u043E \u043D\u0430 \u0442\u0440\u043E\u043D\u0435. \u0422\u044B
        \u043C\u0435\u0447\u0442\u0430\u043B \u0441\u0430\u043C \u0441\u0435\u0441\u0442\u044C
        \u043D\u0430 \u0442\u0440\u043E\u043D? \u042F \u043F\u043E\u043D\u0438\u043C\u0430\u044E
        \u044D\u0442\u0443 \u043C\u0435\u0447\u0442\u0443. \u041D\u043E \u043D\u0435
        \u0442\u0432\u043E\u0438 \u043C\u0435\u0442\u043E\u0434\u044B. \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
        \u043B\u0435\u043F\u0435\u0441\u0442\u043E\u043A \u2014 \u0438 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C."
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_06_l3_lose
      <FallbackText>k__BackingField: "\u0422\u0440\u043E\u043D\u043D\u044B\u0439
        \u0437\u0430\u043B \u0436\u0434\u0451\u0442 \u0437\u0430\u043A\u043E\u043D\u043D\u043E\u0433\u043E
        \u043D\u0430\u0441\u043B\u0435\u0434\u043D\u0438\u043A\u0430. \u042F \u0436\u0434\u0430\u0442\u044C
        \u0443\u043C\u0435\u044E \u2014 \u043D\u043E \u043B\u0443\u0447\u0448\u0435
        \u043D\u0435 \u043D\u0430\u0434\u043E. \u0421\u043D\u043E\u0432\u0430!"
