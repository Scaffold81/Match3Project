  m_Name: Stage02_Story
  m_EditorClassIdentifier: Assembly-CSharp::Match3.Configs.StageStoryConfig
  <StageSelectStory>k__BackingField:
    <Image>k__BackingField: {fileID: 0}
    <LocalizationId>k__BackingField: india_02_select
    <FallbackText>k__BackingField: "\u0414\u0436\u0430\u0439\u043F\u0443\u0440 \u2014
      \u0420\u043E\u0437\u043E\u0432\u044B\u0439 \u0413\u043E\u0440\u043E\u0434!
      \u0412\u0441\u0451 \u0437\u0434\u0435\u0441\u044C \u0440\u043E\u0437\u043E\u0432\u043E\u0435
      \u2014 \u0432 \u0447\u0435\u0441\u0442\u044C \u0446\u0432\u0435\u0442\u0430
      \u0433\u043E\u0441\u0442\u0435\u043F\u0440\u0438\u0438\u043C\u0441\u0442\u0432\u0430.
      \u041A\u0430\u043B\u0438 \u0432\u044B\u0431\u0440\u0430\u043B \u0438\u043C\u0435\u043D\u043D\u043E
      \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E \u0447\u0442\u043E\u0431\u044B
      \u0441\u043F\u0440\u044F\u0442\u0430\u0442\u044C \u0432\u0442\u043E\u0440\u043E\u0439
      \u043B\u0435\u043F\u0435\u0441\u0442\u043E\u043A \u2014 \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435
      \u0438\u0437 \u0437\u043B\u043E\u0431\u044B. \u041D\u0430\u0439\u0434\u0451\u043C
      \u043B\u0435\u043F\u0435\u0441\u0442\u043E\u043A \u0438 \u0432\u0435\u0440\u043D\u0451\u043C
      \u0414\u0436\u0430\u0439\u043F\u0443\u0440\u0443 \u0435\u0433\u043E \u0447\u0435\u0441\u0442\u044C!"
  <LevelStories>k__BackingField:
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_02_l1_start
      <FallbackText>k__BackingField: "\u0425\u0430\u0432\u0430 \u041C\u0430\u0445\u0430\u043B
        \u2014 \u0414\u0432\u043E\u0440\u0435\u0446 \u0412\u0435\u0442\u0440\u043E\u0432!
        \u0422\u044B\u0441\u044F\u0447\u0430 \u0434\u0435\u0432\u044F\u0442\u044C\u0441\u043E\u0442
        \u043F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442 \u0442\u0440\u0438
        \u043E\u043A\u043D\u0430 \u2014 \u044F \u0441\u0447\u0438\u0442\u0430\u043B
        \u0432 \u0434\u0435\u0442\u0441\u0442\u0432\u0435. \u041A\u0430\u043C\u043D\u0438
        \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u043D\u044B \u043F\u043E \u044D\u0442\u0430\u0436\u0430\u043C
        \u043A\u0430\u043A \u043B\u0435\u043F\u0435\u0441\u0442\u043A\u0438 \u0440\u043E\u0437.
        \u0421\u043E\u0431\u0438\u0440\u0430\u0439 \u0432\u0441\u0435 \u0448\u0435\u0441\u0442\u044C
        \u0446\u0432\u0435\u0442\u043E\u0432 \u2014 \u0432\u0442\u043E\u0440\u043E\u0439
        \u043B\u0435\u043F\u0435\u0441\u0442\u043E\u043A \u0441\u043F\u0440\u044F\u0442\u0430\u043D
        \u043D\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u043C \u044D\u0442\u0430\u0436\u0435."
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_02_l1_lose
      <FallbackText>k__BackingField: "\u0412\u0435\u0442\u0435\u0440 \u0443\u043D\u043E\u0441\u0438\u0442
        \u043A\u0430\u043C\u043D\u0438 \u2014 \u0432 \u043C\u0435\u0442\u0430\u0444\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u043C
        \u0441\u043C\u044B\u0441\u043B\u0435. \u0412 \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E\u043C
        \u0441\u043C\u044B\u0441\u043B\u0435 \u2014 \u044F \u043F\u0440\u043E\u0441\u0442\u043E
        \u043D\u0435 \u0443\u0441\u043F\u0435\u043B. \u0421\u043D\u043E\u0432\u0430!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_02_l2_start
      <FallbackText>k__BackingField: "\u042F\u043D\u0442\u0440-\u041C\u0430\u043D\u0442\u0440
        \u2014 \u043E\u0431\u0441\u0435\u0440\u0432\u0430\u0442\u043E\u0440\u0438\u044F
        \u0430\u0441\u0442\u0440\u043E\u043D\u043E\u043C\u043E\u0432! \u041A\u0430\u043C\u043D\u0438
        \u0437\u0434\u0435\u0441\u044C \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u044B
        \u043F\u043E \u0437\u0432\u0451\u0437\u0434\u043D\u044B\u043C \u043F\u043E\u0437\u0438\u0446\u0438\u044F\u043C
        \u2014 \u0441\u043E\u0431\u0438\u0440\u0430\u0439 \u0432 \u0442\u043E\u043C
        \u043F\u043E\u0440\u044F\u0434\u043A\u0435 \u043A\u043E\u0442\u043E\u0440\u044B\u0439
        \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442
        \u0441\u043E\u0437\u0432\u0435\u0437\u0434\u0438\u044E \u0418\u043D\u0434\u0440\u044B.
        \u0418\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043E\u0431\u0438\u0440\u0430\u0439
        \u0432\u0441\u0451 \u0447\u0442\u043E \u0432\u0438\u0434\u0438\u0448\u044C
        \u2014 \u0442\u043E\u0436\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442."
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_02_l2_lose
      <FallbackText>k__BackingField: "\u0417\u0432\u0451\u0437\u0434\u043D\u044B\u0439
        \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u043D\u0430\u0440\u0443\u0448\u0435\u043D.
        \u0410\u0441\u0442\u0440\u043E\u043B\u043E\u0433\u0438 \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B.
        \u041A\u0430\u043A \u0438 \u044F. \u0415\u0449\u0451 \u0440\u0430\u0437!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_02_l3_start
      <FallbackText>k__BackingField: "\u0410\u043C\u0435\u0440 \u0424\u043E\u0440\u0442!
        \u0421\u0430\u043C\u0430\u044F \u0432\u044B\u0441\u043E\u043A\u0430\u044F
        \u0442\u043E\u0447\u043A\u0430 \u0414\u0436\u0430\u0439\u043F\u0443\u0440\u0430
        \u2014 \u0438 \u0432\u0442\u043E\u0440\u043E\u0439 \u043B\u0435\u043F\u0435\u0441\u0442\u043E\u043A
        \u0433\u0434\u0435-\u0442\u043E \u0437\u0434\u0435\u0441\u044C \u0432 \u043A\u043B\u0430\u0434\u043A\u0435
        \u0441\u0442\u0435\u043D. \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
        \u043A\u0430\u043C\u043D\u0438 \u0443 \u044E\u0436\u043D\u043E\u0439 \u0431\u0430\u0448\u043D\u0438.
        \u0421\u043E\u0431\u0435\u0440\u0451\u043C \u0438\u0445 \u2014 \u0438 \u0441\u0442\u0435\u043D\u044B
        \u0441\u0430\u043C\u0438 \u0443\u043A\u0430\u0436\u0443\u0442 \u0433\u0434\u0435
        \u043B\u0435\u043F\u0435\u0441\u0442\u043E\u043A!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_02_l3_win
      <FallbackText>k__BackingField: "\u0412\u0442\u043E\u0440\u043E\u0439 \u043B\u0435\u043F\u0435\u0441\u0442\u043E\u043A!
        \u0421\u0435\u0440\u0435\u0431\u0440\u0438\u0441\u0442\u044B\u0439 \u043A\u0430\u043A
        \u043B\u0443\u043D\u043D\u044B\u0439 \u0441\u0432\u0435\u0442! \u041A\u0430\u043B\u0438,
        \u0442\u044B \u043F\u0440\u044F\u0447\u0435\u0448\u044C \u0438\u0445 \u0432
        \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0445 \u043C\u0435\u0441\u0442\u0430\u0445
        \u2014 \u044D\u0442\u043E \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
        \u0447\u0442\u043E \u0442\u0435\u0431\u044F \u043E\u043F\u0440\u0430\u0432\u0434\u044B\u0432\u0430\u0435\u0442.
        \u041F\u043E\u043A\u0430 \u0447\u0442\u043E. \u041B\u0435\u0442\u0438\u043C
        \u0432 \u0412\u0430\u0440\u0430\u043D\u0430\u0441\u0438!"
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_02_l3_lose
      <FallbackText>k__BackingField: "\u042E\u0436\u043D\u0430\u044F \u0431\u0430\u0448\u043D\u044F
        \u0434\u0435\u0440\u0436\u0438\u0442 \u0442\u0430\u0439\u043D\u0443. \u041A\u0430\u043A
        \u0432\u0441\u0435 \u0445\u043E\u0440\u043E\u0448\u0438\u0435 \u0431\u0430\u0448\u043D\u0438.
        \u0415\u0449\u0451 \u0440\u0430\u0437 \u2014 \u0438 \u0442\u0430\u0439\u043D\u0430
        \u043D\u0430\u0448\u0430!"
