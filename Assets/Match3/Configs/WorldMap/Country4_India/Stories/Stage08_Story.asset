  m_Name: Stage08_Story
  m_EditorClassIdentifier: Assembly-CSharp::Match3.Configs.StageStoryConfig
  <StageSelectStory>k__BackingField:
    <Image>k__BackingField: {fileID: 0}
    <LocalizationId>k__BackingField: india_08_select
    <FallbackText>k__BackingField: "\u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u043C\u0441\u044F
      \u0432 \u0410\u0433\u0440\u0443! \u0414\u0432\u043E\u0440\u0435\u0446 \u043A\u043E\u0440\u043E\u043D\u0430\u0446\u0438\u0438
      \u0436\u0434\u0451\u0442. \u041D\u043E \u0421\u043E\u0432\u0435\u0442\u043D\u0438\u043A
      \u041A\u0430\u043B\u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0447\u0442\u043E
      \u0435\u0433\u043E \u0441\u0442\u0430\u0440\u044B\u0435 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u044F
      \u0435\u0449\u0451 \u0434\u0435\u0440\u0436\u0430\u0442\u0441\u044F \u0432
      \u0441\u0442\u0435\u043D\u0430\u0445. \u041D\u0443\u0436\u043D\u043E \u043E\u0447\u0438\u0441\u0442\u0438\u0442\u044C
      \u0434\u0432\u043E\u0440\u0435\u0446 \u043E\u0442 \u043E\u0441\u0442\u0430\u0442\u043A\u043E\u0432
      \u043C\u0430\u0433\u0438\u0438. \u041E\u0447\u0438\u0441\u0442\u0438\u043C
      \u0438\u0445 \u0432\u043C\u0435\u0441\u0442\u0435."
  <LevelStories>k__BackingField:
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_08_l1_start
      <FallbackText>k__BackingField: "\u0422\u0440\u043E\u043D\u043D\u044B\u0439
        \u0437\u0430\u043B \u0410\u0433\u0440\u044B \u2014 \u0437\u0434\u0435\u0441\u044C
        \u043F\u0440\u043E\u0439\u0434\u0451\u0442 \u043A\u043E\u0440\u043E\u043D\u0430\u0446\u0438\u044F.
        \u041E\u0441\u0442\u0430\u0442\u043A\u0438 \u043B\u044C\u0434\u0430 \u041A\u0430\u043B\u0438
        \u0442\u0430\u044E\u0442 \u0441\u0430\u043C\u0438 \u2014 \u043D\u043E \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E.
        \u041F\u043E\u043C\u043E\u0433\u0430\u0435\u043C \u0438\u043C. \u0421\u043E\u0431\u0438\u0440\u0430\u0435\u043C
        \u043A\u0430\u043C\u043D\u0438 \u0438 \u0440\u0430\u0437\u0431\u0438\u0432\u0430\u0435\u043C
        \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u043B\u0451\u0434
        \u2014 \u0442\u0440\u043E\u043D\u043D\u044B\u0439 \u0437\u0430\u043B \u0434\u043E\u043B\u0436\u0435\u043D
        \u0441\u0438\u044F\u0442\u044C!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_08_l1_lose
      <FallbackText>k__BackingField: "\u041B\u0451\u0434 \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
        \u2014 \u0441\u0442\u0430\u0440\u0430\u044F \u043C\u0430\u0433\u0438\u044F
        \u0443\u043F\u0440\u044F\u043C\u0430. \u041D\u043E \u043D\u0435 \u0443\u043F\u0440\u044F\u043C\u0435\u0435
        \u043D\u0430\u0448\u0435\u0433\u043E \u0436\u0435\u043B\u0430\u043D\u0438\u044F.
        \u0421\u043D\u043E\u0432\u0430!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_08_l2_start
      <FallbackText>k__BackingField: "\u0421\u043E\u0432\u0435\u0442\u043D\u0438\u043A
        \u041A\u0430\u043B\u0438 \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442
        \u0441\u043E\u0432\u0435\u0442\u043E\u043C! \u0413\u043E\u0432\u043E\u0440\u0438\u0442
        \u2014 \u0446\u0435\u043F\u0438 \u043E\u0441\u043B\u0430\u0431\u043D\u0443\u0442
        \u0435\u0441\u043B\u0438 \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u043A\u0430\u043C\u043D\u0438
        \u0432 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u043E\u043C
        \u043F\u043E\u0440\u044F\u0434\u043A\u0435. \u042F \u043D\u0435\u043C\u043D\u043E\u0433\u043E
        \u0435\u043C\u0443 \u0432\u0435\u0440\u044E. \u041D\u0435\u043C\u043D\u043E\u0433\u043E.
        \u041F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u043C \u2014 \u0438 \u0440\u0432\u0451\u043C
        \u0446\u0435\u043F\u0438!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_08_l2_lose
      <FallbackText>k__BackingField: "\u0421\u043E\u0432\u0435\u0442 \u041A\u0430\u043B\u0438
        \u043D\u0435 \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B. \u0418\u043B\u0438
        \u044F \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E
        \u043F\u043E\u043D\u044F\u043B. \u041E\u0431\u0441\u0443\u0434\u0438\u043C
        \u043F\u043E\u0442\u043E\u043C \u2014 \u0441\u043D\u043E\u0432\u0430 \u0441\u0432\u043E\u0438\u043C
        \u0443\u043C\u043E\u043C!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_08_l3_start
      <FallbackText>k__BackingField: "\u0424\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0435
        \u043F\u0440\u0435\u0433\u0440\u0430\u0434\u044B \u0443 \u0442\u0440\u043E\u043D\u0430!
        \u041B\u043E\u0442\u043E\u0441 \u0418\u043D\u0434\u0440\u044B \u0432 \u043C\u043E\u0438\u0445
        \u0440\u0443\u043A\u0430\u0445 \u2014 \u0432\u0441\u0435 \u0441\u0435\u043C\u044C
        \u043B\u0435\u043F\u0435\u0441\u0442\u043A\u043E\u0432. \u0420\u0430\u0437\u043E\u0431\u044C\u0451\u043C
        \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u043B\u0451\u0434
        \u0438 \u0440\u0430\u0437\u043E\u0440\u0432\u0451\u043C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044E\u044E
        \u0446\u0435\u043F\u044C \u2014 \u0438 \u0446\u0435\u0440\u0435\u043C\u043E\u043D\u0438\u044F
        \u043D\u0430\u0447\u043D\u0451\u0442\u0441\u044F. \u042D\u0442\u043E \u043C\u043E\u043C\u0435\u043D\u0442
        \u0437\u0430 \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u044F \u0448\u0451\u043B
        \u0432\u0441\u044E \u0436\u0438\u0437\u043D\u044C!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_08_l3_win
      <FallbackText>k__BackingField: "\u0414\u0412\u041E\u0420\u0415\u0426 \u041E\u0427\u0418\u0429\u0415\u041D!
        \u0422\u0440\u043E\u043D \u0441\u0432\u043E\u0431\u043E\u0434\u0435\u043D!
        \u041B\u043E\u0442\u043E\u0441 \u0418\u043D\u0434\u0440\u044B \u0441\u0438\u044F\u0435\u0442...
        \u044F \u043A\u043B\u0430\u0434\u0443 \u0435\u0433\u043E \u043D\u0430 \u043C\u0435\u0441\u0442\u043E.
        \u0421\u043E\u0432\u0435\u0442\u043D\u0438\u043A \u041A\u0430\u043B\u0438
        \u0441\u0442\u043E\u0438\u0442 \u0440\u044F\u0434\u043E\u043C \u2014 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
        \u043D\u0435\u043B\u043E\u0432\u043A\u043E \u043D\u043E \u0447\u0435\u0441\u0442\u043D\u043E.
        \u041A\u043E\u0440\u043E\u043D\u0430\u0446\u0438\u044F \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F.
        \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u044D\u0442\u0430\u043F
        \u2014 \u0440\u0438\u0442\u0443\u0430\u043B \u0418\u043D\u0434\u0440\u044B!"
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: india_08_l3_lose
      <FallbackText>k__BackingField: "\u0422\u0440\u043E\u043D \u043F\u043E\u0447\u0442\u0438
        \u0433\u043E\u0442\u043E\u0432 \u043F\u0440\u0438\u043D\u044F\u0442\u044C
        \u043C\u0435\u043D\u044F! \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435
        \u0443\u0441\u0438\u043B\u0438\u0435 \u2014 \u0441\u043D\u043E\u0432\u0430!"
