  m_Name: Stage03_Story
  m_EditorClassIdentifier: Assembly-CSharp::Match3.Configs.StageStoryConfig
  <StageSelectStory>k__BackingField:
    <Image>k__BackingField: {fileID: 0}
    <LocalizationId>k__BackingField: greece_03_select
    <FallbackText>k__BackingField: "\u041F\u043E\u0434 \u0445\u0440\u0430\u043C\u043E\u043C
      \u2014 \u043A\u0430\u0442\u0430\u043A\u043E\u043C\u0431\u044B \u0436\u0440\u0435\u0446\u043E\u0432.
      \u041A\u0442\u043E-\u0442\u043E \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u043B
      \u043F\u0440\u043E\u0445\u043E\u0434\u044B \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u043C
      \u043B\u044C\u0434\u043E\u043C \u043F\u043E\u0441\u043B\u0435 \u0437\u0435\u043C\u043B\u0435\u0442\u0440\u044F\u0441\u0435\u043D\u0438\u044F.
      \u041D\u0430\u043C\u0435\u0440\u0435\u043D\u043D\u043E. \u042D\u0442\u043E
      \u0443\u0436\u0435 \u043D\u0435 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u0441\u0442\u044C.
      \u041D\u0430\u043C \u043D\u0443\u0436\u043D\u043E \u043F\u0440\u043E\u0431\u0438\u0442\u044C\u0441\u044F
      \u0432\u043D\u0443\u0442\u0440\u044C."
  <LevelStories>k__BackingField:
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: greece_03_l1_start
      <FallbackText>k__BackingField: "\u041B\u0435\u0434\u044F\u043D\u044B\u0435
        \u043F\u0435\u0447\u0430\u0442\u0438 \u0432 \u043A\u0430\u0442\u0430\u043A\u043E\u043C\u0431\u0430\u0445
        \u2014 \u044D\u0442\u043E \u0434\u0440\u0435\u0432\u043D\u044F\u044F \u0437\u0430\u0449\u0438\u0442\u043D\u0430\u044F
        \u043C\u0430\u0433\u0438\u044F \u0436\u0440\u0435\u0446\u043E\u0432 \u041F\u043E\u0441\u0435\u0439\u0434\u043E\u043D\u0430.
        \u0412\u0440\u0430\u0433\u043E\u0432 \u0410\u0444\u0438\u043D\u044B. \u0422\u0435\u043F\u0435\u0440\u044C
        \u044F \u0442\u043E\u0447\u043D\u043E \u0437\u043D\u0430\u044E \u0447\u0442\u043E
        \u0437\u0435\u043C\u043B\u0435\u0442\u0440\u044F\u0441\u0435\u043D\u0438\u0435
        \u0431\u044B\u043B\u043E \u0430\u0442\u0430\u043A\u043E\u0439. \u0420\u0430\u0437\u0431\u0438\u0432\u0430\u0435\u043C
        \u043B\u0451\u0434 \u2014 \u043D\u0430\u043C \u043D\u0443\u0436\u043D\u044B
        \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: greece_03_l1_lose
      <FallbackText>k__BackingField: "\u041B\u0451\u0434 \u041F\u043E\u0441\u0435\u0439\u0434\u043E\u043D\u0430
        \u043A\u0440\u0435\u043F\u0447\u0435 \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E
        \u2014 \u043C\u043E\u0440\u0441\u043A\u0430\u044F \u0441\u043E\u043B\u044C
        \u0432 \u0441\u043E\u0441\u0442\u0430\u0432\u0435 \u0434\u0430\u0451\u0442
        \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E
        \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C. \u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0439
        \u0444\u0430\u043A\u0442. \u0411\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0439
        \u0441\u0435\u0439\u0447\u0430\u0441, \u043D\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0439.
        \u041F\u0440\u043E\u0431\u0443\u0435\u043C \u0441\u043D\u043E\u0432\u0430!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: greece_03_l2_start
      <FallbackText>k__BackingField: "\u041E\u0434\u0438\u043D \u043F\u0440\u043E\u0445\u043E\u0434
        \u043E\u0442\u043A\u0440\u044B\u0442! \u0412\u043D\u0443\u0442\u0440\u0438
        \u2014 \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435 \u0441\u0442\u0430\u0440\u044B\u0445
        \u0441\u0432\u0438\u0442\u043A\u043E\u0432 \u0438 \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u043D\u043D\u044B\u0435
        \u043E\u0441\u043A\u043E\u043B\u043A\u0438. \u0412\u0442\u043E\u0440\u043E\u0439
        \u0431\u043B\u043E\u043A \u043B\u044C\u0434\u0430 \u0441\u0442\u043E\u0438\u0442
        \u0443 \u0432\u0445\u043E\u0434\u0430 \u0432 \u0433\u043B\u0430\u0432\u043D\u0443\u044E
        \u043A\u0430\u043C\u0435\u0440\u0443. \u0420\u0430\u0437\u0431\u0438\u0432\u0430\u0435\u043C
        \u0435\u0433\u043E \u2014 \u0438 \u0443\u0437\u043D\u0430\u0435\u043C \u0447\u0442\u043E
        \u0442\u0430\u043C \u0441\u043A\u0440\u044B\u0442\u043E."
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: greece_03_l2_lose
      <FallbackText>k__BackingField: "\u0413\u043B\u0430\u0432\u043D\u0430\u044F
        \u043A\u0430\u043C\u0435\u0440\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u0430.
        \u041F\u043E\u0441\u0435\u0439\u0434\u043E\u043D \u0445\u043E\u0440\u043E\u0448\u043E
        \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u043B\u0441\u044F. \u041D\u043E
        \u0410\u0444\u0438\u043D\u0430 \u043C\u0443\u0434\u0440\u0435\u0435 \u2014
        \u0430 \u0437\u043D\u0430\u0447\u0438\u0442 \u0438 \u043C\u044B \u043C\u0443\u0434\u0440\u0435\u0435.
        \u0415\u0449\u0451 \u0440\u0430\u0437!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: greece_03_l3_start
      <FallbackText>k__BackingField: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
        \u043B\u0435\u0434\u044F\u043D\u043E\u0439 \u0431\u0430\u0440\u044C\u0435\u0440!
        \u0417\u0430 \u043D\u0438\u043C \u2014 \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435
        \u041E\u0441\u043A\u043E\u043B\u043A\u043E\u0432 \u041C\u0443\u0434\u0440\u043E\u0441\u0442\u0438
        \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u044B\u0445 \u0441\u0430\u043C\u043E\u0439
        \u0410\u0444\u0438\u043D\u043E\u0439. \u0415\u0441\u043B\u0438 \u041F\u043E\u0441\u0435\u0439\u0434\u043E\u043D
        \u0445\u043E\u0442\u0435\u043B \u0438\u0445 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C
        \u2014 \u043C\u044B \u043D\u0435 \u0434\u0430\u0434\u0438\u043C. \u0420\u0430\u0437\u0431\u0438\u0432\u0430\u0435\u043C!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: greece_03_l3_win
      <FallbackText>k__BackingField: "\u0425\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435
        \u043E\u0442\u043A\u0440\u044B\u0442\u043E! \u041E\u0441\u043A\u043E\u043B\u043A\u0438
        \u043D\u0435\u0442\u0440\u043E\u043D\u0443\u0442\u044B! \u041F\u043E\u0441\u0435\u0439\u0434\u043E\u043D
        \u043D\u0435 \u0443\u0441\u043F\u0435\u043B. \u0410 \u043C\u044B \u0443\u0441\u043F\u0435\u043B\u0438.
        \u0417\u0430\u043F\u0438\u0448\u0443 \u044D\u0442\u043E \u0432 \u0445\u0440\u043E\u043D\u0438\u043A\u0443
        \u2014 \u0441 \u0442\u043E\u0447\u043D\u044B\u043C \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C
        \u0438 \u0434\u0430\u0442\u043E\u0439."
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: greece_03_l3_lose
      <FallbackText>k__BackingField: "\u041F\u043E\u0441\u0435\u0439\u0434\u043E\u043D
        \u0441\u0442\u0430\u0432\u0438\u043B \u044D\u0442\u0443 \u0437\u0430\u0449\u0438\u0442\u0443
        \u0441 \u0443\u043C\u043E\u043C. \u0423\u0432\u0430\u0436\u0430\u044E \u0432\u0440\u0430\u0433\u0430.
        \u041D\u043E \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u0441\u043B\u043E\u043C\u0430\u0435\u043C
        \u2014 \u0435\u0449\u0451 \u0440\u0430\u0437!"
