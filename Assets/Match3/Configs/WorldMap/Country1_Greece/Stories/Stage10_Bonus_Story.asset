  m_Script: {fileID: 11500000, guid: 2b17b268e1fb7734bb975e5058e1bd11, type: 3}
  m_Name: Stage10_Bonus_Story
  m_EditorClassIdentifier: Assembly-CSharp::Match3.Configs.StageStoryConfig
  <StageSelectStory>k__BackingField:
    <Image>k__BackingField: {fileID: 0}
    <LocalizationId>k__BackingField: greece_10_select
    <FallbackText>k__BackingField: "\u0410\u0444\u0438\u043D\u0430 \u043B\u0438\u0447\u043D\u043E
      \u043F\u0440\u0438\u0433\u043B\u0430\u0441\u0438\u043B\u0430 \u043D\u0430\u0441
      \u0432 \u0427\u0435\u0440\u0442\u043E\u0433\u0438 \u0411\u043E\u0433\u043E\u0432
      \u2014 \u043C\u0435\u0441\u0442\u043E \u0433\u0434\u0435 \u0445\u0440\u0430\u043D\u044F\u0442\u0441\u044F
      \u041E\u0441\u043A\u043E\u043B\u043A\u0438 \u0432\u0441\u0435\u0445 \u0448\u0435\u0441\u0442\u0438
      \u0421\u0442\u0438\u0445\u0438\u0439. \u041E\u043D\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442:
      \xAB\u0422\u043E\u0442 \u043A\u0442\u043E \u0441\u043E\u0431\u0435\u0440\u0451\u0442
      \u0438\u0445 \u0432\u0441\u0435 \u2014 \u043F\u043E\u043B\u0443\u0447\u0438\u0442
      \u0447\u0430\u0441\u0442\u0438\u0446\u0443 \u043C\u0443\u0434\u0440\u043E\u0441\u0442\u0438
      \u041E\u043B\u0438\u043C\u043F\u0430\xBB. \u042D\u0442\u043E \u0432\u0435\u043B\u0438\u0447\u0430\u0439\u0448\u0430\u044F
      \u0447\u0435\u0441\u0442\u044C \u0434\u043B\u044F \u0441\u043C\u0435\u0440\u0442\u043D\u043E\u0433\u043E.
      \u042F \u0431\u0443\u0434\u0443 \u0432\u0435\u0441\u0442\u0438 \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u044B\u0439
      \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B."
  <LevelStories>k__BackingField:
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: greece_10_l1_start
      <FallbackText>k__BackingField: "\u0428\u0435\u0441\u0442\u044C \u0441\u0442\u0438\u0445\u0438\u0439
        \u2014 \u0448\u0435\u0441\u0442\u044C \u0446\u0432\u0435\u0442\u043E\u0432
        \u041E\u0441\u043A\u043E\u043B\u043A\u043E\u0432. \u041E\u0433\u043E\u043D\u044C,
        \u0412\u043E\u0434\u0430, \u0417\u0435\u043C\u043B\u044F, \u0412\u043E\u0437\u0434\u0443\u0445,
        \u0421\u0432\u0435\u0442 \u0438 \u0422\u044C\u043C\u0430. \u041E\u043D\u0438
        \u0440\u0435\u0434\u043A\u043E \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0442\u0441\u044F
        \u0432\u043C\u0435\u0441\u0442\u0435 \u2014 \u044D\u0442\u043E \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0439
        \u043C\u043E\u043C\u0435\u043D\u0442. \u0421\u043E\u0431\u0438\u0440\u0430\u0439
        \u0432\u0441\u0435 \u2014 \u0438 \u043D\u0435 \u0443\u0440\u043E\u043D\u0438
        \u043D\u0438 \u043E\u0434\u043D\u043E\u0433\u043E!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: greece_10_l1_lose
      <FallbackText>k__BackingField: "\u0421\u0442\u0438\u0445\u0438\u0438 \u043A\u0430\u043F\u0440\u0438\u0437\u043D\u044B
        \u2014 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u0422\u044C\u043C\u0430
        \u0438 \u0421\u0432\u0435\u0442 \u043A\u043E\u0442\u043E\u0440\u044B\u0435
        \u0438\u0437\u0431\u0435\u0433\u0430\u044E\u0442 \u0434\u0440\u0443\u0433
        \u0434\u0440\u0443\u0433\u0430. \u041D\u0443\u0436\u043D\u0430 \u043E\u0441\u043E\u0431\u0430\u044F
        \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044F \u2014 \u0441\u043D\u043E\u0432\u0430!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: greece_10_l2_start
      <FallbackText>k__BackingField: "\u0421\u0442\u0438\u0445\u0438\u0438 \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442
        \u0440\u0435\u0437\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C
        \u0434\u0440\u0443\u0433 \u0441 \u0434\u0440\u0443\u0433\u043E\u043C \u2014
        \u0432\u0438\u0434\u0438\u0448\u044C \u043A\u0430\u043A \u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F
        \u0446\u0432\u0435\u0442\u0430? \u042D\u0442\u043E \u0445\u043E\u0440\u043E\u0448\u0438\u0439
        \u0437\u043D\u0430\u043A. \u0410\u0444\u0438\u043D\u0430 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0435\u0442.
        \u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439 \u2014 \u0434\u043E
        \u0444\u0438\u043D\u0430\u043B\u0430 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
        \u043D\u0435\u043C\u043D\u043E\u0433\u043E!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: greece_10_l2_lose
      <FallbackText>k__BackingField: "\u0420\u0435\u0437\u043E\u043D\u0430\u043D\u0441
        \u043F\u0440\u0435\u0440\u0432\u0430\u043B\u0441\u044F. \u0410\u0444\u0438\u043D\u0430
        \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442... \u0440\u0430\u0437\u043E\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u043D\u043E?
        \u041D\u0435\u0442, \u044D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E
        \u043E\u0431\u043B\u0430\u043A\u043E. \u0415\u0449\u0451 \u043E\u0434\u043D\u0430
        \u043F\u043E\u043F\u044B\u0442\u043A\u0430!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: greece_10_l3_start
      <FallbackText>k__BackingField: "\u0424\u0438\u043D\u0430\u043B! \u0412\u0441\u0435
        \u0448\u0435\u0441\u0442\u044C \u041E\u0441\u043A\u043E\u043B\u043A\u043E\u0432
        \u0421\u0442\u0438\u0445\u0438\u0439 \u043F\u0435\u0440\u0435\u0434 \u0442\u043E\u0431\u043E\u0439.
        \u0410\u0444\u0438\u043D\u0430, \u0417\u0435\u0432\u0441, \u0432\u0441\u0435
        \u0431\u043E\u0433\u0438 \u041E\u043B\u0438\u043C\u043F\u0430 \u0441\u043C\u043E\u0442\u0440\u044F\u0442
        \u043D\u0430 \u044D\u0442\u043E\u0442 \u043C\u043E\u043C\u0435\u043D\u0442.
        \u0421\u043E\u0431\u0435\u0440\u0438 \u0438\u0445 \u2014 \u0438 \u043C\u0443\u0434\u0440\u043E\u0441\u0442\u044C
        \u0431\u043E\u0433\u043E\u0432 \u0431\u0443\u0434\u0435\u0442 \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E
        \u0442\u0432\u043E\u0435\u0439. \u041D\u0438 \u0448\u0430\u0433\u0443 \u043D\u0430\u0437\u0430\u0434!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: greece_10_l3_win
      <FallbackText>k__BackingField: "\u0412\u0421\u0415 \u0428\u0415\u0421\u0422\u042C
        \u041E\u0421\u041A\u041E\u041B\u041A\u041E\u0412 \u0421\u041E\u0411\u0420\u0410\u041D\u042B!
        \u0410\u0444\u0438\u043D\u0430 \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F.
        \u0417\u0435\u0432\u0441 \u043A\u0438\u0432\u0430\u0435\u0442. \u042F \u043F\u043B\u0430\u0447\u0443
        \u2014 \u0438 \u043D\u0435 \u0441\u0442\u044B\u0436\u0443\u0441\u044C \u044D\u0442\u043E\u0433\u043E.
        \u0425\u0440\u043E\u043D\u0438\u043A\u0430 \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u0430.
        \u041F\u043E\u0431\u0435\u0434\u0430 \u0437\u0430\u043F\u0438\u0441\u0430\u043D\u0430.
        \u0413\u0440\u0435\u0446\u0438\u044F \u2014 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u0430
        \u0438 \u043C\u0443\u0434\u0440\u0430!"
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: greece_10_l3_lose
      <FallbackText>k__BackingField: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
        \u043E\u0441\u043A\u043E\u043B\u043A\u0438 \u0443\u0441\u043A\u043E\u043B\u044C\u0437\u0430\u044E\u0442.
        \u0411\u043E\u0433\u0438 \u0442\u0435\u0440\u043F\u0435\u043B\u0438\u0432\u044B
        \u2014 \u0438 \u043C\u044B \u0442\u043E\u0436\u0435. \u0424\u0438\u043D\u0430\u043B\u044C\u043D\u0430\u044F
        \u043F\u043E\u043F\u044B\u0442\u043A\u0430 \u2014 \u043E\u043D\u0430 \u0431\u0443\u0434\u0435\u0442
        \u043F\u043E\u0431\u0435\u0434\u043D\u043E\u0439!"
