  m_Name: Stage08_Story
  m_EditorClassIdentifier: Assembly-CSharp::Match3.Configs.StageStoryConfig
  <StageSelectStory>k__BackingField:
    <Image>k__BackingField: {fileID: 0}
    <LocalizationId>k__BackingField: maya_08_select
    <FallbackText>k__BackingField: "\u0422\u0443\u043B\u0443\u043C \u2014 \u0433\u043E\u0440\u043E\u0434
      \u043D\u0430 \u0431\u0435\u0440\u0435\u0433\u0443 \u043C\u043E\u0440\u044F.
      \u041A\u0443\u043A\u0443\u043B\u044C\u043A\u0430\u043D \u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u0437\u0434\u0435\u0441\u044C \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0435
      \u2014 \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0435 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0435\u043D\u0438\u0435
      \u0442\u0435\u043C \u043A\u0442\u043E \u0435\u0433\u043E \u043E\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u043B.
      \u041D\u043E \u0422\u0451\u043C\u043D\u044B\u0439 \u0417\u043C\u0435\u0439
      \u0432 \u043E\u0442\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u0438 \u0437\u0430\u043C\u043E\u0440\u043E\u0437\u0438\u043B
      \u043F\u043E\u0431\u0435\u0440\u0435\u0436\u044C\u0435 \u0438 \u0441\u043A\u0440\u0443\u0442\u0438\u043B
      \u043F\u0440\u043E\u0445\u043E\u0434\u044B \u0446\u0435\u043F\u044F\u043C\u0438."
  <LevelStories>k__BackingField:
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: maya_08_l1_start
      <FallbackText>k__BackingField: "\u041B\u0435\u0434\u044F\u043D\u043E\u0435
        \u043F\u043E\u0431\u0435\u0440\u0435\u0436\u044C\u0435 \u2014 \u043A\u0440\u0430\u0441\u0438\u0432\u043E
        \u0438 \u043D\u0435\u0443\u043C\u0435\u0441\u0442\u043D\u043E. \u0422\u0451\u043C\u043D\u044B\u0439
        \u0417\u043C\u0435\u0439 \u0438\u0437 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0445
        \u0441\u0438\u043B. \u0420\u0430\u0437\u0431\u0438\u0432\u0430\u0435\u043C
        \u043B\u0451\u0434 \u2014 \u043C\u043E\u0440\u0435 \u0434\u043E\u043B\u0436\u043D\u043E
        \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0431\u0435\u0440\u0435\u0433\u0443.
        \u041A\u0430\u043C\u043D\u0438 \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0435\u043D\u0438\u044F
        \u043F\u043E\u0434 \u043B\u044C\u0434\u043E\u043C, \u043E\u043D\u0438 \u0442\u0451\u043F\u043B\u044B\u0435
        \u2014 \u043F\u043E\u0447\u0442\u0438 \u0433\u043E\u0440\u044F\u0447\u0438\u0435."
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: maya_08_l1_lose
      <FallbackText>k__BackingField: "\u041C\u043E\u0440\u0435 \u0436\u0434\u0451\u0442.
        \u041C\u044B \u043D\u0435\u043D\u0430\u0434\u043E\u043B\u0433\u043E \u2014
        \u0441\u043D\u043E\u0432\u0430!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: maya_08_l2_start
      <FallbackText>k__BackingField: "\u0426\u0435\u043F\u0438 \u0443 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u0445
        \u0432\u043E\u0440\u043E\u0442 \u2014 \u0422\u0451\u043C\u043D\u044B\u0439
        \u0417\u043C\u0435\u0439 \u0445\u043E\u0442\u0435\u043B \u0437\u0430\u043F\u0435\u0440\u0435\u0442\u044C
        \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0435 \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430.
        \u042D\u0442\u043E \u0435\u0433\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F
        \u0441\u0442\u0430\u0432\u043A\u0430. \u0420\u0432\u0451\u043C \u0446\u0435\u043F\u0438
        \u2014 \u0438 \u0432\u043E\u0440\u043E\u0442\u0430 \u043E\u0442\u043A\u0440\u043E\u044E\u0442\u0441\u044F."
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: maya_08_l2_lose
      <FallbackText>k__BackingField: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F
        \u0441\u0442\u0430\u0432\u043A\u0430 \u0422\u0451\u043C\u043D\u043E\u0433\u043E
        \u0417\u043C\u0435\u044F \u2014 \u043A\u0440\u0435\u043F\u043A\u0430\u044F.
        \u041D\u043E \u043D\u0435 \u043A\u0440\u0435\u043F\u0447\u0435 \u043D\u0430\u0448\u0435\u0439
        \u0440\u0435\u0448\u0438\u043C\u043E\u0441\u0442\u0438. \u0421\u043D\u043E\u0432\u0430!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: maya_08_l3_start
      <FallbackText>k__BackingField: "\u0410\u043B\u0442\u0430\u0440\u044C \u0443
        \u0431\u0435\u0440\u0435\u0433\u0430 \u043C\u043E\u0440\u044F \u2014 \u0442\u0430\u043C
        \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0435 \u041A\u0430\u043C\u043D\u0438
        \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0435\u043D\u0438\u044F.
        \u0420\u0430\u0437\u0431\u0438\u0432\u0430\u0435\u043C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
        \u043F\u0440\u0435\u0433\u0440\u0430\u0434\u044B \u0438 \u0447\u0438\u0442\u0430\u0435\u043C
        \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0435 \u041A\u0443\u043A\u0443\u043B\u044C\u043A\u0430\u043D\u0430."
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: maya_08_l3_win
      <FallbackText>k__BackingField: "\u041F\u043E\u0441\u043B\u0430\u043D\u0438\u0435
        \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043D\u043E: \xAB\u0421\u043F\u0430\u0441\u0438\u0431\u043E
        \u0442\u0435\u043C \u043A\u0442\u043E \u043D\u0435 \u043F\u043E\u0431\u043E\u044F\u043B\u0441\u044F
        \u0441\u0447\u0438\u0442\u0430\u0442\u044C \u0437\u0432\u0451\u0437\u0434\u044B\xBB.
        \u042F... \u044F \u0441\u0447\u0438\u0442\u0430\u043B\u0430 \u0437\u0432\u0451\u0437\u0434\u044B
        \u0432\u0441\u044E \u0436\u0438\u0437\u043D\u044C. \u042D\u0442\u043E \u0434\u043B\u044F
        \u043C\u0435\u043D\u044F. \u041A\u0443\u043A\u0443\u043B\u044C\u043A\u0430\u043D
        \u0443\u043B\u0435\u0442\u0430\u0435\u0442 \u0432 \u043D\u0435\u0431\u043E.
        \u041D\u0435\u0431\u043E \u043D\u0430\u0434 \u0422\u0443\u043B\u0443\u043C\u043E\u043C
        \u0447\u0438\u0441\u0442\u043E\u0435."
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: maya_08_l3_lose
      <FallbackText>k__BackingField: "\u0424\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0435
        \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0435 \u0436\u0434\u0451\u0442.
        \u041D\u0435\u043C\u043D\u043E\u0433\u043E \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u044F
        \u2014 \u0438 \u043E\u043D\u043E \u043D\u0430\u0448\u0435!"
