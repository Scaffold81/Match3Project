  m_Script: {fileID: 11500000, guid: 2b17b268e1fb7734bb975e5058e1bd11, type: 3}
  m_Name: Stage07_Story
  m_EditorClassIdentifier: Assembly-CSharp::Match3.Configs.StageStoryConfig
  <StageSelectStory>k__BackingField:
    <Image>k__BackingField: {fileID: 0}
    <LocalizationId>k__BackingField: maya_07_select
    <FallbackText>k__BackingField: "\u0422\u0435\u043E\u0442\u0438\u0443\u0430\u043A\u0430\u043D
      \u2014 \xAB\u041C\u0435\u0441\u0442\u043E \u0433\u0434\u0435 \u0440\u043E\u0436\u0434\u0430\u044E\u0442\u0441\u044F
      \u0431\u043E\u0433\u0438\xBB. \u0422\u0451\u043C\u043D\u044B\u0439 \u0417\u043C\u0435\u0439
      \u043F\u0440\u0438\u0448\u0451\u043B \u0441\u044E\u0434\u0430 \u043F\u0435\u0440\u0432\u044B\u043C
      \u0438 \u0432\u044B\u0441\u0442\u0430\u0432\u0438\u043B \u0432\u0441\u0435
      \u043F\u0440\u0435\u0433\u0440\u0430\u0434\u044B: \u044F\u0449\u0438\u043A\u0438,
      \u0446\u0435\u043F\u0438. \u041E\u043D \u0445\u043E\u0447\u0435\u0442 \u043F\u043E\u0433\u043B\u043E\u0442\u0438\u0442\u044C
      \u0417\u0432\u0451\u0437\u0434\u043D\u044B\u0435 \u041A\u0430\u043C\u043D\u0438
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u041A\u0443\u043A\u0443\u043B\u044C\u043A\u0430\u043D
      \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F. \u0424\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0439
      \u0433\u043E\u0440\u043E\u0434."
  <LevelStories>k__BackingField:
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: maya_07_l1_start
      <FallbackText>k__BackingField: "\u0410\u043B\u043B\u0435\u044F \u041C\u0451\u0440\u0442\u0432\u044B\u0445
        \u0437\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u0430
        \u044F\u0449\u0438\u043A\u0430\u043C\u0438. \u0422\u0451\u043C\u043D\u044B\u0439
        \u0417\u043C\u0435\u0439 \u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0431\u044B\u0441\u0442\u0440\u043E.
        \u041D\u043E \u043C\u044B \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u043C
        \u0443\u043C\u043D\u0435\u0435. \u0420\u0430\u0437\u0431\u0438\u0440\u0430\u0435\u043C
        \u044F\u0449\u0438\u043A\u0438 \u0438 \u0438\u0449\u0435\u043C \u041A\u0430\u043C\u043D\u0438
        \u0420\u043E\u0436\u0434\u0435\u043D\u0438\u044F \u2014 \u043E\u043D\u0438
        \u0441\u0430\u043C\u044B\u0435 \u044F\u0440\u043A\u0438\u0435, \u043F\u043E\u0447\u0442\u0438
        \u043A\u0430\u043A \u0437\u0432\u0451\u0437\u0434\u044B."
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: maya_07_l1_lose
      <FallbackText>k__BackingField: "\u0422\u0451\u043C\u043D\u044B\u0439 \u0417\u043C\u0435\u0439
        \u0434\u043E\u0432\u043E\u043B\u0435\u043D. \u0420\u0430\u043D\u043E. \u0415\u0449\u0451
        \u0440\u0430\u0437 \u2014 \u0438 \u044F\u0449\u0438\u043A\u0438 \u043D\u0435
        \u0443\u0441\u0442\u043E\u044F\u0442!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: maya_07_l2_start
      <FallbackText>k__BackingField: "\u041F\u0438\u0440\u0430\u043C\u0438\u0434\u0430
        \u0421\u043E\u043B\u043D\u0446\u0430! \u0421\u0430\u043C\u0430\u044F \u0431\u043E\u043B\u044C\u0448\u0430\u044F
        \u0437\u0434\u0435\u0441\u044C. \u0426\u0435\u043F\u0438 \u0443 \u043F\u043E\u0434\u043D\u043E\u0436\u0438\u044F
        \u2014 \u0422\u0451\u043C\u043D\u044B\u0439 \u0417\u043C\u0435\u0439 \u0437\u0430\u043F\u0435\u0440
        \u0435\u0451. \u041E\u043D \u0431\u043E\u0438\u0442\u0441\u044F \u0447\u0442\u043E
        \u0421\u043E\u043B\u043D\u0435\u0447\u043D\u0430\u044F \u041F\u0438\u0440\u0430\u043C\u0438\u0434\u0430
        \u0443\u0441\u0438\u043B\u0438\u0442 \u041A\u0443\u043A\u0443\u043B\u044C\u043A\u0430\u043D\u0430.
        \u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u0431\u043E\u0438\u0442\u0441\u044F.
        \u0420\u0432\u0451\u043C \u0446\u0435\u043F\u0438!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: maya_07_l2_lose
      <FallbackText>k__BackingField: "\u0421\u043E\u043B\u043D\u0435\u0447\u043D\u0430\u044F
        \u041F\u0438\u0440\u0430\u043C\u0438\u0434\u0430 \u0436\u0434\u0451\u0442
        \u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0435\u043D\u0438\u044F.
        \u041C\u044B \u043D\u0435 \u043F\u043E\u0434\u0432\u0435\u0434\u0451\u043C
        \u2014 \u0441\u043D\u043E\u0432\u0430!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: maya_07_l3_start
      <FallbackText>k__BackingField: "\u041F\u0438\u0440\u0430\u043C\u0438\u0434\u0430
        \u041B\u0443\u043D\u044B \u2014 \u0444\u0438\u043D\u0430\u043B. \u0412\u0441\u0435
        \u0417\u0432\u0451\u0437\u0434\u043D\u044B\u0435 \u041A\u0430\u043C\u043D\u0438
        \u0434\u043E\u043B\u0436\u043D\u044B \u0441\u043E\u0439\u0442\u0438\u0441\u044C
        \u0437\u0434\u0435\u0441\u044C. \u0422\u0451\u043C\u043D\u044B\u0439 \u0417\u043C\u0435\u0439
        \u0441\u0442\u043E\u0438\u0442 \u043D\u0430 \u0432\u0435\u0440\u0448\u0438\u043D\u0435
        \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442. \u041F\u0443\u0441\u0442\u044C
        \u0441\u043C\u043E\u0442\u0440\u0438\u0442. \u0420\u0430\u0437\u043D\u0435\u0441\u0438
        \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u043F\u0440\u0435\u0433\u0440\u0430\u0434\u044B
        \u0438 \u0441\u043E\u0431\u0435\u0440\u0438 \u0432\u0441\u0435 \u0448\u0435\u0441\u0442\u044C
        \u0446\u0432\u0435\u0442\u043E\u0432 \u2014 \u041A\u0443\u043A\u0443\u043B\u044C\u043A\u0430\u043D
        \u0443\u0441\u043B\u044B\u0448\u0438\u0442!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: maya_07_l3_win
      <FallbackText>k__BackingField: "\u0412\u0421\u0415 \u0417\u0412\u0401\u0417\u0414\u041D\u042B\u0415
        \u041A\u0410\u041C\u041D\u0418 \u0421\u041E\u0411\u0420\u0410\u041D\u042B!
        \u041D\u0435\u0431\u043E \u043D\u0430\u0434 \u0422\u0435\u043E\u0442\u0438\u0443\u0430\u043A\u0430\u043D\u043E\u043C
        \u0437\u0430\u0433\u043E\u0440\u0435\u043B\u043E\u0441\u044C! \u0422\u0451\u043C\u043D\u044B\u0439
        \u0417\u043C\u0435\u0439 \u043A\u0440\u0438\u0447\u0438\u0442 \u0438 \u043E\u0442\u0441\u0442\u0443\u043F\u0430\u0435\u0442!
        \u0418 \u0432\u043E\u0442 \u2014 \u041A\u0443\u043A\u0443\u043B\u044C\u043A\u0430\u043D!
        \u041E\u043D... \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0439. \u0418
        \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0439. \u0421\u043C\u043E\u0442\u0440\u0438\u0442
        \u043D\u0430 \u043D\u0430\u0441. \u042F \u043C\u043E\u043B\u0447\u0443. \u041F\u0435\u0440\u0432\u044B\u0439
        \u0440\u0430\u0437 \u0437\u0430 \u043E\u0447\u0435\u043D\u044C \u0434\u043E\u043B\u0433\u043E."
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: maya_07_l3_lose
      <FallbackText>k__BackingField: "\u0422\u0451\u043C\u043D\u044B\u0439 \u0417\u043C\u0435\u0439
        \u0434\u0443\u043C\u0430\u0435\u0442 \u0447\u0442\u043E \u043F\u043E\u0431\u0435\u0434\u0438\u043B.
        \u041E\u043D \u043E\u0448\u0438\u0431\u0430\u0435\u0442\u0441\u044F \u2014
        \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0440\u0430\u0437,
        \u0438 \u041A\u0443\u043A\u0443\u043B\u044C\u043A\u0430\u043D \u0441\u0432\u043E\u0431\u043E\u0434\u0435\u043D!"
