  m_Script: {fileID: 11500000, guid: 2b17b268e1fb7734bb975e5058e1bd11, type: 3}
  m_Name: Stage03_Story
  m_EditorClassIdentifier: Assembly-CSharp::Match3.Configs.StageStoryConfig
  <StageSelectStory>k__BackingField:
    <Image>k__BackingField: {fileID: 0}
    <LocalizationId>k__BackingField: maya_03_select
    <FallbackText>k__BackingField: "\u0422\u0438\u043A\u0430\u043B\u044C \u2014 \u0433\u043E\u0440\u043E\u0434
      \u0432 \u0434\u0436\u0443\u043D\u0433\u043B\u044F\u0445. \u0417\u0434\u0435\u0441\u044C
      \u0432\u043B\u0430\u0436\u043D\u043E, \u0436\u0430\u0440\u043A\u043E \u0438...
      \u043F\u043E\u0447\u0435\u043C\u0443 \u043B\u0451\u0434? \u0412 \u0442\u0440\u043E\u043F\u0438\u0447\u0435\u0441\u043A\u043E\u043C
      \u043B\u0435\u0441\u0443 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u043B\u0451\u0434. \u041A\u0442\u043E \u0431\u044B \u044D\u0442\u043E \u043D\u0438
      \u0441\u0434\u0435\u043B\u0430\u043B, \u043E\u043D \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442
      \u043C\u0430\u0433\u0438\u044E \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u044F
      \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E. \u042D\u0442\u043E
      \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E."
  <LevelStories>k__BackingField:
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: maya_03_l1_start
      <FallbackText>k__BackingField: "\u041B\u0451\u0434 \u0432 \u0434\u0436\u0443\u043D\u0433\u043B\u044F\u0445
        \u2014 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u043D\u0430\u044F
        \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u044F. \u041A\u0442\u043E \u0431\u044B
        \u044D\u0442\u043E \u043D\u0438 \u0441\u0434\u0435\u043B\u0430\u043B, \u043E\u043D
        \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 \u043C\u0430\u0433\u0438\u044E
        \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u044F \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E.
        \u042D\u0442\u043E \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E.
        \u0420\u0430\u0437\u0431\u0438\u0432\u0430\u0435\u043C \u043B\u0451\u0434
        \u043C\u0430\u0442\u0447\u0430\u043C\u0438 \u0440\u044F\u0434\u043E\u043C
        \u0438 \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u043C \u041A\u0430\u043C\u043D\u0438
        \u0414\u0432\u0438\u0436\u0435\u043D\u0438\u044F."
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: maya_03_l1_lose
      <FallbackText>k__BackingField: "\u0410\u043D\u043E\u043C\u0430\u043B\u0438\u044F
        \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u0435\u0439
        \u0447\u0435\u043C \u044F \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043B\u0430.
        \u041F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u0430\u044E \u043A\u043E\u044D\u0444\u0444\u0438\u0446\u0438\u0435\u043D\u0442
        \u0438 \u0441\u043D\u043E\u0432\u0430!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: maya_03_l2_start
      <FallbackText>k__BackingField: "\u041E\u0434\u0438\u043D \u0431\u043B\u043E\u043A
        \u043B\u044C\u0434\u0430 \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D!
        \u041F\u043E\u0434 \u043D\u0438\u043C \u2014 \u043D\u0430\u0441\u043A\u0430\u043B\u044C\u043D\u044B\u0435
        \u0440\u0438\u0441\u0443\u043D\u043A\u0438. \u041A\u0443\u043A\u0443\u043B\u044C\u043A\u0430\u043D
        \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0451\u043D \u0438\u043C\u0435\u043D\u043D\u043E
        \u0437\u0434\u0435\u0441\u044C, \u0432 \u0422\u0438\u043A\u0430\u043B\u0435.
        \u042D\u0442\u043E \u043C\u0435\u0441\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u043C\u043E
        \u0434\u043B\u044F \u043F\u0440\u043E\u0440\u043E\u0447\u0435\u0441\u0442\u0432\u0430.
        \u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: maya_03_l2_lose
      <FallbackText>k__BackingField: "\u0420\u0438\u0441\u0443\u043D\u043A\u0438
        \u0436\u0434\u0443\u0442. \u041C\u044B \u0436\u0434\u0451\u043C. \u0422\u043E\u043B\u044C\u043A\u043E
        \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u2014 \u0438 \u0441\u043D\u043E\u0432\u0430
        \u043A \u0434\u0435\u043B\u0443!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: maya_03_l3_start
      <FallbackText>k__BackingField: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
        \u043B\u0435\u0434\u044F\u043D\u043E\u0439 \u0431\u043B\u043E\u043A \u0443
        \u0433\u043B\u0430\u0432\u043D\u043E\u0433\u043E \u0445\u0440\u0430\u043C\u0430!
        \u041F\u0440\u043E\u0440\u043E\u0447\u0435\u0441\u0442\u0432\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442:
        \xAB\u0414\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u043A\u0430\u043C\u043D\u0435\u0439
        \u2014 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u0437\u0432\u0451\u0437\u0434\xBB.
        \u0420\u0430\u0437\u0431\u0435\u0439 \u043B\u0451\u0434 \u2014 \u0438 \u0437\u0432\u0451\u0437\u0434\u044B
        \u0441\u0434\u0432\u0438\u043D\u0443\u0442\u0441\u044F \u043D\u0430 \u043D\u0443\u0436\u043D\u044B\u0435
        \u043F\u043E\u0437\u0438\u0446\u0438\u0438."
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: maya_03_l3_win
      <FallbackText>k__BackingField: "\u041A\u0430\u043C\u043D\u0438 \u0441\u043E\u0431\u0440\u0430\u043D\u044B!
        \u0418... \u0440\u0438\u0441\u0443\u043D\u043A\u0438 \u043D\u0430 \u0441\u0442\u0435\u043D\u0430\u0445
        \u0437\u0430\u0441\u0432\u0435\u0442\u0438\u043B\u0438\u0441\u044C. \u042F
        \u043D\u0430\u043F\u0438\u0441\u0430\u043B\u0430 \xAB\u043D\u0435\u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043C\u043E\xBB
        \u0432 \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u0435. \u042D\u0442\u043E
        \u043F\u0435\u0440\u0432\u044B\u0439 \u0440\u0430\u0437 \u0437\u0430 \u0442\u0440\u0438
        \u0433\u043E\u0434\u0430 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439.
        \u0418\u0434\u0451\u043C \u0432 \u041F\u0430\u043B\u0435\u043D\u043A\u0435
        \u2014 \u0442\u0430\u043C \u043E\u0442\u0432\u0435\u0442\u044B."
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: maya_03_l3_lose
      <FallbackText>k__BackingField: "\u0417\u0432\u0451\u0437\u0434\u044B \u0436\u0434\u0443\u0442
        \u043D\u0430\u0448\u0435\u0433\u043E \u0441\u0438\u0433\u043D\u0430\u043B\u0430.
        \u0414\u0430\u0434\u0438\u043C \u0438\u043C \u2014 \u0435\u0449\u0451 \u0440\u0430\u0437!"
