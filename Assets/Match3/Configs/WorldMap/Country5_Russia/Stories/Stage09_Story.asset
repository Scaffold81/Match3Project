  m_Script: {fileID: 11500000, guid: 2b17b268e1fb7734bb975e5058e1bd11, type: 3}
  m_Name: Stage09_Story
  m_EditorClassIdentifier: Assembly-CSharp::Match3.Configs.StageStoryConfig
  <StageSelectStory>k__BackingField:
    <Image>k__BackingField: {fileID: 0}
    <LocalizationId>k__BackingField: russia_09_select
    <FallbackText>k__BackingField: "\u042D\u0442\u043E... \u044D\u0442\u043E \u043E\u043D\u0430.
      \u0421\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u043D\u0438\u0446\u0430! \u042F
      \u0438\u0441\u043A\u0430\u043B \u0435\u0451 \u0441\u043E\u0440\u043E\u043A
      \u043B\u0435\u0442. \u0421\u041E\u0420\u041E\u041A \u041B\u0415\u0422! \u0418
      \u0432\u043E\u0442 \u2014 \u043B\u0435\u0434\u044F\u043D\u044B\u0435 \u0437\u0430\u043C\u043A\u0438
      \u0438 \u0446\u0435\u043F\u0438 \u043F\u0440\u044F\u043C\u043E \u043F\u0435\u0440\u0435\u0434
      \u0432\u0445\u043E\u0434\u043E\u043C. \u041A\u043E\u043D\u0435\u0447\u043D\u043E.
      \u042D\u0442\u043E \u0415\u0433\u0438\u043F\u0435\u0442, \u0437\u0434\u0435\u0441\u044C
      \u043D\u0438\u0447\u0435\u0433\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0430\u043A
      \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F.
      \u041D\u043E \u043C\u044B \u0441\u043F\u0440\u0430\u0432\u0438\u043C\u0441\u044F!"
  <LevelStories>k__BackingField:
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: russia_09_l1_start
      <FallbackText>k__BackingField: "\u041B\u0451\u0434 \u0438 \u0446\u0435\u043F\u0438
        \u0432\u043C\u0435\u0441\u0442\u0435 \u2014 \u0432\u044B\u0441\u0448\u0438\u0439
        \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u0437\u0430\u0449\u0438\u0442\u044B.
        \u041B\u0451\u0434 \u0442\u0430\u0435\u043C \u043C\u0430\u0442\u0447\u0430\u043C\u0438
        \u0440\u044F\u0434\u043E\u043C, \u0446\u0435\u043F\u0438 \u0440\u0432\u0451\u043C
        \u0442\u0430\u043A \u0436\u0435. \u0412\u0441\u0451 \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
        \u2014 \u0437\u0432\u0443\u0447\u0438\u0442 \u043A\u0430\u043A \u043F\u043B\u0430\u043D!
        \u041D\u0443, \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E \u043A\u0430\u043A
        \u043F\u043B\u0430\u043D. \u0414\u0435\u0439\u0441\u0442\u0432\u0443\u0439!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: russia_09_l1_lose
      <FallbackText>k__BackingField: "\u0421\u043E\u0440\u043E\u043A \u043B\u0435\u0442
        \u0436\u0434\u0430\u043B \u2014 \u0435\u0449\u0451 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
        \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u0442. \u0422\u044B \u043F\u043E\u043D\u044F\u043B
        \u0447\u0442\u043E \u043D\u0443\u0436\u043D\u043E \u0434\u0435\u043B\u0430\u0442\u044C
        \u2014 \u0441\u043D\u043E\u0432\u0430!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: russia_09_l2_start
      <FallbackText>k__BackingField: "\u0424\u043E\u0440\u043C\u0430 \u0422! \u0421\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u043D\u0438\u0446\u0430
        \u0441\u0442\u0440\u043E\u0438\u043B\u0430\u0441\u044C \u0432 \u0444\u043E\u0440\u043C\u0435
        \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u043E\u0433\u043E \u0410\u043D\u043A\u0445\u0430
        \u2014 \u0437\u043D\u0430\u043A\u0430 \u0432\u0435\u0447\u043D\u043E\u0439
        \u0436\u0438\u0437\u043D\u0438. \u0412\u043E\u0442 \u043F\u043E\u0447\u0435\u043C\u0443
        \u044F \u0435\u0451 \u0441\u043E\u0440\u043E\u043A \u043B\u0435\u0442 \u0438\u0441\u043A\u0430\u043B.
        \u041D\u0435 \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043F\u043B\u043E\u0445\u043E
        \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u0443\u044E\u0441\u044C.
        \u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u043C!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: russia_09_l2_lose
      <FallbackText>k__BackingField: "\u0410\u043D\u043A\u0445 \u043D\u0435 \u043F\u0443\u0441\u043A\u0430\u0435\u0442.
        \u0421\u0438\u043C\u0432\u043E\u043B\u0438\u0447\u043D\u043E \u2014 \u0437\u043D\u0430\u043A
        \u0436\u0438\u0437\u043D\u0438 \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u0442
        \u0441\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u0435 \u0436\u0438\u0437\u043D\u0438.
        \u041D\u043E \u043C\u044B \u043D\u0430\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u0435\u0435
        \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u0432!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: russia_09_l3_start
      <FallbackText>k__BackingField: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F
        \u0437\u0430\u0449\u0438\u0442\u0430 \u043F\u0435\u0440\u0435\u0434 \u0434\u0432\u0435\u0440\u044C\u044E!
        \u0412\u0441\u0435 \u043F\u044F\u0442\u044C \u0446\u0432\u0435\u0442\u043E\u0432
        \u043A\u0430\u043C\u043D\u0435\u0439, \u043B\u0451\u0434, \u0446\u0435\u043F\u0438
        \u2014 \u0432\u0441\u0451 \u0437\u0434\u0435\u0441\u044C. \u0424\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0435
        \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435 \u0424\u0430\u0440\u0430\u043E\u043D\u0430.
        \u041F\u043E\u043A\u0430\u0436\u0438 \u0435\u043C\u0443 \u0447\u0442\u043E
        \u043C\u044B \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u044B!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: russia_09_l3_win
      <FallbackText>k__BackingField: "\u0414\u0412\u0415\u0420\u042C \u041E\u0422\u041A\u0420\u042B\u041B\u0410\u0421\u042C!
        \u0421\u043E\u0440\u043E\u043A \u043B\u0435\u0442... \u044F \u0432\u0438\u0436\u0443
        \u0437\u043E\u043B\u043E\u0442\u043E. \u0418 \u0442\u0430\u043C, \u0432 \u0446\u0435\u043D\u0442\u0440\u0435
        \u2014 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0421\u043B\u0451\u0437\u044B
        \u0420\u0430! \u0427\u0443\u0436\u0435\u0441\u0442\u0440\u0430\u043D\u0435\u0446,
        \u044F \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u044D\u0442\u043E\u0433\u043E
        \u043D\u0435 \u0437\u0430\u0431\u0443\u0434\u0443. \u041D\u0443, \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C
        \u043D\u0435 \u0437\u0430\u0431\u044B\u0442\u044C."
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: russia_09_l3_lose
      <FallbackText>k__BackingField: "\u0422\u0430\u043A \u0431\u043B\u0438\u0437\u043A\u043E!
        \u0414\u0432\u0435\u0440\u044C \u043F\u043E\u0447\u0442\u0438 \u043E\u0442\u043A\u0440\u044B\u043B\u0430\u0441\u044C
        \u2014 \u044F \u0441\u043B\u044B\u0448\u0430\u043B \u0441\u043A\u0440\u0438\u043F!
        \u0415\u0449\u0451 \u043E\u0434\u0438\u043D \u0440\u0430\u0437 \u2014 \u0438
        \u043C\u044B \u0432\u043D\u0443\u0442\u0440\u0438!"
