  m_Script: {fileID: 11500000, guid: 2b17b268e1fb7734bb975e5058e1bd11, type: 3}
  m_Name: Stage07_Story
  m_EditorClassIdentifier: Assembly-CSharp::Match3.Configs.StageStoryConfig
  <StageSelectStory>k__BackingField:
    <Image>k__BackingField: {fileID: 0}
    <LocalizationId>k__BackingField: russia_07_select
    <FallbackText>k__BackingField: "\u041A\u0430\u0442\u0430\u043A\u043E\u043C\u0431\u044B
      \u043F\u043E\u0434 \u043F\u0438\u0440\u0430\u043C\u0438\u0434\u043E\u0439!
      \u0417\u0434\u0435\u0441\u044C \u0432\u0441\u0451 \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u0435\u0435
      \u2014 \u044F\u0449\u0438\u043A\u0438 \u0438 \u0446\u0435\u043F\u0438. \u0426\u0435\u043F\u0438!
      \u041A\u0442\u043E \u0432\u043E\u043E\u0431\u0449\u0435 \u0437\u0430\u043A\u043E\u0432\u044B\u0432\u0430\u0435\u0442
      \u043A\u0430\u043C\u043D\u0438 \u0432 \u0446\u0435\u043F\u0438?! \u041A\u0430\u043A\u043E\u0439-\u0442\u043E
      \u043E\u0447\u0435\u043D\u044C \u043F\u0430\u0440\u0430\u043D\u043E\u0438\u0434\u0430\u043B\u044C\u043D\u044B\u0439
      \u0436\u0440\u0435\u0446, \u0432\u043E\u0442 \u043A\u0442\u043E. \u042D\u0442\u043E
      \u0431\u0443\u0434\u0435\u0442 \u043D\u0435\u043F\u0440\u043E\u0441\u0442\u043E."
  <LevelStories>k__BackingField:
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: russia_07_l1_start
      <FallbackText>k__BackingField: "\u0412\u0438\u0434\u0438\u0448\u044C \u0446\u0435\u043F\u0438
        \u043D\u0430 \u0442\u0435\u0445 \u043A\u0430\u043C\u043D\u044F\u0445? \u041F\u043E\u043A\u0430
        \u0446\u0435\u043F\u044C \u0446\u0435\u043B\u0430 \u2014 \u043A\u0430\u043C\u0435\u043D\u044C
        \u043D\u0435 \u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F. \u0414\u0435\u043B\u0430\u0439
        \u043C\u0430\u0442\u0447\u0438 \u0440\u044F\u0434\u043E\u043C \u2014 \u0446\u0435\u043F\u044C
        \u043E\u0441\u043B\u0430\u0431\u043D\u0435\u0442 \u0438 \u043B\u043E\u043F\u043D\u0435\u0442.
        \u0417\u0430\u043E\u0434\u043D\u043E \u0440\u0430\u0437\u0431\u0438\u0432\u0430\u0439
        \u044F\u0449\u0438\u043A\u0438. \u041C\u043D\u043E\u0433\u043E\u0437\u0430\u0434\u0430\u0447\u043D\u043E\u0441\u0442\u044C
        \u2014 \u043A\u043B\u044E\u0447 \u043A \u0443\u0441\u043F\u0435\u0445\u0443
        \u0432 \u043A\u0430\u0442\u0430\u043A\u043E\u043C\u0431\u0430\u0445!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: russia_07_l1_lose
      <FallbackText>k__BackingField: "\u0426\u0435\u043F\u0438 \u043A\u0440\u0435\u043F\u043A\u0438\u0435.
        \u042F\u0449\u0438\u043A\u0438 \u043A\u0440\u0435\u043F\u043A\u0438\u0435.
        \u041C\u044B \u2014 \u0442\u043E\u0436\u0435 \u043A\u0440\u0435\u043F\u043A\u0438\u0435!
        \u041F\u0440\u043E\u0441\u0442\u043E... \u043F\u043E\u043A\u0430 \u043D\u0435
        \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E. \u041F\u0440\u043E\u0431\u0443\u0435\u043C
        \u0441\u043D\u043E\u0432\u0430."
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: russia_07_l2_start
      <FallbackText>k__BackingField: "\u041B\u0435\u0441\u0442\u043D\u0438\u0447\u043D\u044B\u0439
        \u0437\u0430\u043B! \u041A\u0430\u0442\u0430\u043A\u043E\u043C\u0431\u044B
        \u0443\u0445\u043E\u0434\u044F\u0442 \u0432\u043D\u0438\u0437 \u0441\u0442\u0443\u043F\u0435\u043D\u044F\u043C\u0438
        \u2014 \u043A\u0440\u0430\u0441\u0438\u0432\u043E, \u0435\u0441\u043B\u0438
        \u043D\u0435 \u0434\u0443\u043C\u0430\u0442\u044C \u0447\u0442\u043E \u043C\u044B
        \u0433\u043B\u0443\u0431\u043E\u043A\u043E \u043F\u043E\u0434 \u0437\u0435\u043C\u043B\u0451\u0439.
        \u042F\u0449\u0438\u043A\u0438 \u043F\u043E \u0431\u043E\u043A\u0430\u043C,
        \u0446\u0435\u043F\u0438 \u0432 \u0446\u0435\u043D\u0442\u0440\u0435. \u0414\u0435\u0439\u0441\u0442\u0432\u0443\u0439
        \u043C\u0435\u0442\u043E\u0434\u0438\u0447\u043D\u043E!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: 
      <FallbackText>k__BackingField: 
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: russia_07_l2_lose
      <FallbackText>k__BackingField: "\u041C\u0435\u0442\u043E\u0434\u0438\u0447\u043D\u043E
        \u043D\u0435 \u0432\u044B\u0448\u043B\u043E. \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C
        \u0445\u0430\u043E\u0442\u0438\u0447\u043D\u043E? \u0428\u0443\u0447\u0443.
        \u041C\u0435\u0442\u043E\u0434\u0438\u0447\u043D\u043E, \u043D\u043E \u043B\u0443\u0447\u0448\u0435!"
  - <StartStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: russia_07_l3_start
      <FallbackText>k__BackingField: "\u0412\u044B\u0445\u043E\u0434 \u0438\u0437
        \u043A\u0430\u0442\u0430\u043A\u043E\u043C\u0431! \u0412\u0438\u0436\u0443
        \u0441\u0432\u0435\u0442 \u0432\u043F\u0435\u0440\u0435\u0434\u0438 \u2014
        \u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0446\u0435\u043F\u0438
        \u0441 \u044F\u0449\u0438\u043A\u0430\u043C\u0438 \u043F\u0435\u0440\u0435\u0434
        \u043D\u0438\u043C. \u041F\u044F\u0442\u044C \u0446\u0432\u0435\u0442\u043E\u0432
        \u043A\u0430\u043C\u043D\u0435\u0439 \u0436\u0434\u0443\u0442 \u043D\u0430\u0441.
        \u0420\u0430\u0437\u043D\u0435\u0441\u0438 \u0432\u0441\u0451 \u0447\u0442\u043E
        \u043C\u0435\u0448\u0430\u0435\u0442 \u2014 \u043C\u044B \u043F\u043E\u0447\u0442\u0438
        \u0443 \u0446\u0435\u043B\u0438!"
    <WinStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: russia_07_l3_win
      <FallbackText>k__BackingField: "\u0421\u0432\u043E\u0431\u043E\u0434\u0430!
        \u0418 \u0432\u0441\u0435 \u043F\u044F\u0442\u044C \u0446\u0432\u0435\u0442\u043E\u0432
        \u0421\u043B\u0451\u0437 \u0420\u0430! \u042F \u0443\u0436\u0435 \u0434\u0443\u043C\u0430\u043B
        \u043C\u044B \u043E\u0441\u0442\u0430\u043D\u0435\u043C\u0441\u044F \u0437\u0434\u0435\u0441\u044C
        \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430... \u043D\u043E \u043D\u0435\u0442.
        \u041C\u044B \u0432\u0435\u043B\u0438\u043A\u043E\u043B\u0435\u043F\u043D\u044B.
        \u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u044F."
    <LoseStory>k__BackingField:
      <Image>k__BackingField: {fileID: 0}
      <LocalizationId>k__BackingField: russia_07_l3_lose
      <FallbackText>k__BackingField: "\u0412\u044B\u0445\u043E\u0434 \u0442\u0430\u043A
        \u0431\u043B\u0438\u0437\u043A\u043E! \u041D\u043E \u0446\u0435\u043F\u0438
        \u0438 \u044F\u0449\u0438\u043A\u0438 \u0433\u043E\u0432\u043E\u0440\u044F\u0442
        \xAB\u043D\u0435\u0442\xBB. \u041C\u044B \u0433\u043E\u0432\u043E\u0440\u0438\u043C
        \xAB\u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C\xBB \u2014 \u0437\u0430\u0445\u043E\u0434\u0438\u043C
        \u0441\u043D\u043E\u0432\u0430!"
